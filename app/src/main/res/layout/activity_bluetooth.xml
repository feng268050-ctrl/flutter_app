<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

<LinearLayout
    android:layout_width="1280dp"
    android:layout_height="800dp"
    android:orientation="vertical"
    android:background="@color/safety_black"
    tools:context=".activitys.other.BluetoothManagerActivity">

    <!--&lt;!&ndash;状态栏&ndash;&gt;-->
    <com.lasercyber.lws.ui.component.EquipmentStatusBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/engineer_equipment_status"
        app:use_title="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="@mipmap/job_border1">

        <LinearLayout
            android:id="@+id/go_to_up_page"
            android:layout_width="200dp"
            android:layout_height="72dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:textSize="24dp"
                android:background="@mipmap/top_page_icon"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="30sp"
                android:textColor="@color/white"
                android:gravity="center" />
        </LinearLayout>

        <TextView android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="-200dp"
            android:layout_height="wrap_content"
            android:text="@string/bluetooth_settings"
            android:textSize="29sp"
            android:textColor="@color/white"
            android:gravity="center" />
    </LinearLayout>

    <!-- 蓝牙开关栏（和WiFi页顶部一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="@drawable/bg_custom_bitmap"
        android:orientation="vertical"
        android:layout_margin="24dp"
        android:paddingTop="24dp"
        android:layout_gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="24dp"
                android:text="bluetooth"
                android:textColor="#FFFFFF"
                android:textSize="35sp" />

            <com.lasercyber.lws.frostui.control.interop.FrostSwitchView
                android:id="@+id/bluetooth_switch"
                style="@style/FrostSwitch"
                android:layout_marginTop="-5dp"
                android:checked="true"
                android:layout_marginRight="24dp" />

        </LinearLayout>

        <View style="@style/engineer_row_line_style" android:layout_marginTop="25dp" android:layout_marginRight="5dp" android:layout_marginBottom="25dp"/>
        <LinearLayout
            android:id="@+id/bluetooth_con_not"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="7"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/bluetooth_con_not_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="24dp"
                android:text="Bluetooth is not enabled."
                android:textColor="@color/side_tab_not_active_color"
                android:textSize="35sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bluetooth_con"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/bluetooth_con_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:paddingLeft="24dp"
                android:textColor="@android:color/white"
                android:textSize="35sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center">
                <TextView
                    android:id="@+id/bluetooth_switch_dd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Connected"
                    android:layout_marginRight="20dp"
                    android:layout_weight="1"
                    android:textColor="@color/tab_text_unselected"
                    android:textSize="29sp" />


            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="430dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:paddingTop="24dp"
        android:orientation="vertical"
        android:background="@drawable/bg_custom_bitmap"
        android:layout_gravity="center">

        <com.lasercyber.lws.ui.component.AppScrollView
            style="@style/app_vertical_scroll_view_style"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:layout_marginTop="20dp">
            <!-- 蓝牙设备列表（复用WiFi页的列表样式） -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_bluetooth_devices"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="8dp" />

        </com.lasercyber.lws.ui.component.AppScrollView>
    </LinearLayout>


</LinearLayout>

</layout>
