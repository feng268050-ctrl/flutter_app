# ek3562 onboard RTL8821CU: soldered module on SoC USB host (not SDIO / not a dongle).
# Driver: mainline rtw88 (rtw_8821cu). Firmware: /lib/firmware/rtw88/ via Buildroot
# linux-firmware (lws_hmi_wifi_rtw88.config). Shared Image — ynh960 still uses AIC SDIO.
#
# After editing RK_KERNEL_CFG_FRAGMENTS:
#   FORCE_KERNEL_IMAGE=1 make build-kernel
#
# On device: lsmod | grep rtw ; lsusb -d 0bda:c811 ; ls /lib/firmware/rtw88/

CONFIG_USB=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y

CONFIG_RTW88=m
CONFIG_RTW88_8821CU=m
