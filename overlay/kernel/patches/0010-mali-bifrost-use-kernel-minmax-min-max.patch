From: lws-hmi kernel overlay
Subject: 0010-mali-bifrost-use-kernel-minmax-min-max.patch

diff -ruN a/drivers/gpu/arm/bifrost/mali_malisw.h b/drivers/gpu/arm/bifrost/mali_malisw.h
--- a/drivers/gpu/arm/bifrost/mali_malisw.h
+++ b/drivers/gpu/arm/bifrost/mali_malisw.h
@@ -26,6 +26,8 @@
 #ifndef _MALISW_H_
 #define _MALISW_H_
 
+#include <linux/minmax.h>
+
 #include <linux/version.h>
 
 /**
@@ -36,7 +38,10 @@
  * As a macro it may evaluate its arguments more than once.
  * Refer to MAX macro for more details
  */
-#define MIN(x, y) ((x) < (y) ? (x) : (y))
+/* LWS: use kernel minmax.h MIN/MAX (6.1.180+) */
+#ifndef MIN
+#define MIN(x, y) min((x), (y))
+#endif
 
 /**
  * MAX - Return the greater of two values.
@@ -50,7 +55,9 @@
  * to retrieve the min and max of two values, consider using a conditional swap
  * instead.
  */
-#define MAX(x, y) ((x) < (y) ? (y) : (x))
+#ifndef MAX
+#define MAX(x, y) max((x), (y))
+#endif
 
 /**
  * CSTD_UNUSED - Function-like macro for suppressing unused variable warnings.
