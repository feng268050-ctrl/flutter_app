# Default rootfs (make build-rootfs): Weston (DRM) + Wayland + eLinux client.
# Enables rockchip-mali wayland-gbm variant (HAS_WAYLAND depends on BR2_PACKAGE_WAYLAND).
# Keep lean: no demo/simple clients. desktop-shell paints boot-splash.png
# until Flutter covers it (kiosk-shell cannot show a background image).
# Paired with lws_hmi_flutter_weston.config by the generated Weston defconfig.

BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DEFAULT_DRM=y
BR2_PACKAGE_WESTON_DRM=y
BR2_PACKAGE_WESTON_SHELL_DESKTOP=y
BR2_PACKAGE_WESTON_SHELL_KIOSK=y
# Explicit: do not pull X11 / demo clients.
# BR2_PACKAGE_WESTON_DEMO_CLIENTS is not set
# BR2_PACKAGE_WESTON_SIMPLE_CLIENTS is not set

# Prebuilt Wayland client (see overlay/buildroot/package/flutter-embedded-linux/).
BR2_PACKAGE_FLUTTER_EMBEDDED_LINUX=y
BR2_PACKAGE_FLUTTER_EMBEDDED_LINUX_WAYLAND=y
BR2_PACKAGE_FLUTTER_EMBEDDED_LINUX_CLIENT=y
