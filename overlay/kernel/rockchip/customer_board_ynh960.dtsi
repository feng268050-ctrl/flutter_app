// ynh960 board DTSI — git source of truth (frozen product baseline).
// Synced to linux-sdk by make apply-overlay. Do not edit only in linux-sdk/.
// Captured from the owned linux-sdk tree (already customized); no upstream vendor
// re-merge. Future vendor drops → copy needed pieces into overlay/ only.

/ {
	 backlight2: backlight2 {
	  compatible = "pwm-backlight";
	  pwms = <&pwm7 0 25000 0>;
	  brightness-levels = <
