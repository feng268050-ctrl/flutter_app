# ext4 rootfs tuning for OTA (see docs/storage-layout.md).
#
# Rockchip base enables BR2_TARGET_ROOTFS_EXT2_SIZE_AUTO: mkfs at
# (target_size + path_count*blksz) * 110% + 64 MiB, then resize2fs -M.
# The 110%/64 MiB only sets the transient mkfs size; the OTA artifact size
# is dominated by INODES=0 (≈1 inode / 4 KiB → ~128k inodes, ~85 MiB overhead
# vs ~5k files used) and whether resize2fs -M can shrink below that floor.
#
# Fixed cap: predictable OTA bundle (~450 MiB vs ~502 MiB today) with ~30 MiB
# free blocks for push-app growth on the 1 GiB GPT slot (no on-device grow step).
BR2_TARGET_ROOTFS_EXT2_SIZE_AUTO=n
BR2_TARGET_ROOTFS_EXT2_SIZE="450M"
# ~5k files today; ~5.7k free inodes at 450M leaves headroom for P5 packages.
BR2_TARGET_ROOTFS_EXT2_INODES=10240
# Embedded appliance: no root-reserved block pool (default 5%).
BR2_TARGET_ROOTFS_EXT2_RESBLKS=0
