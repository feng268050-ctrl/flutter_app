[Unit]
Description=P3.2 emulator tablet→touch bridge (Android Emulator–style input)
DefaultDependencies=yes
After=systemd-udev-settle.service
Before=hmi.service
ConditionKernelCommandLine=lws.emulator=1
ConditionKernelCommandLine=!lws.emulator.input=tablet

[Service]
Type=simple
ExecStart=/usr/libexec/display/emulator-tablet-to-touch
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
