	disable-delay-ms = <60>;
	mipi-data-delay-ms = <60>;
	width-mm = <68>;
	height-mm = <121>;
	dsi,flags = <0xa03>;
	dsi,format = <MIPI_DSI_FMT_RGB888>;
	dsi,lanes = <4>;
	panel-init-sequence-size = <998>;
