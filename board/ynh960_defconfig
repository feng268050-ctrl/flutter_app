RK_KERNEL_VERSION="6.10"
RK_KERNEL_DTS_NAME="ynh960"
# Display / touch / trim / eth / USB gadget / WiFiBT / BT-HID / PMIC RTC: board line.
# emulator-virtio: shared Image also boots under QEMU for P3.2 sim (not a board SKU).
RK_KERNEL_CFG_FRAGMENTS="ynh960-display.config ynh960-touch.config ynh960-kernel-trim.config ynh960-eth.config ynh960-usb-gadget.config ynh960-wifibt.config ynh960-bt-hid.config ynh960-rtc.config ynh960-selinux.config emulator-virtio.config"
RK_PARAMETER="parameter-buildroot-fit.txt"
RK_USE_FIT_IMG=y
# Multi-conf FIT (W5): shared kernel + resource + fdt-<board_id> / conf=<board_id>.
# Generated from board/rk356x-fit-boards.txt via scripts/generate-boot-fit-its.sh.
RK_BOOT_FIT_ITS_NAME="boot-multi.its"
DEFAULT_LCD_PARAM="960_lcd_param_rk356x.txt"
# Docker/offline: skip hard-fail preflight to buildroot.net.
RK_NETWORK_CHECK=n
# P1 USB plug-ssh owns configfs ECM on the DRD UDC; Rockchip usbdevice (ADB) conflicts.
RK_USB_GADGET=n
RK_USB_ADBD=n

RK_BUILDROOT_BASE_CFG="rk3566_rk3568_lws_hmi"
RK_WIFIBT=y
# Keep MODULES non-empty so post-wifibt runs (copies kernel *.ko →
# /vendor/lib/modules). CHIP is mirrored into RK_WIFIBT_MODULES when
# RK_WIFIBT_ON_BOARD; use a non-AP6/RTL/CYW token so Broadcom bcmdhd +
# fw_bcm* are NOT built/copied. Combo firmware lives in the OEM radio pack.
# On-board radio is AIC8800D80 (SDIO c8a1:0082); runtime uses wifibt-bringup.sh.
RK_WIFIBT_ON_BOARD=y
RK_WIFIBT_CHIP="AIC8800D80"
