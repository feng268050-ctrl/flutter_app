# Copy to .env and adjust (do not commit .env).

# Rockchip Linux SDK path (default: ~/Downloads/rk356x_linux6.1_20250730_1126/...)
# LINUX_SDK=~/Downloads/rk356x_linux6.1_20250730_1126/rk356x_linux6.1_20250730_1126

# Host Flutter SDK tree (outside repo; default: ~/Downloads/flutter-sdk-<version>/)
# Contains install/ with bin/flutter. Symlinked as flutter-sdk/ in the repo.
# FLUTTER_SDK=~/Downloads/flutter-sdk-3.24.4

# USB flash: device selection (see make devices)
# SERIAL=0123456789abcdef

# Optional firmware path override for make flash (default: output/firmware/update.img)
# IMAGE=/path/to/update.img

# Docker build tuning (macOS: BUILD_JOBS default 4; Linux native: default 8)
# Phase 1: raise for faster Buildroot/gcc (see docs/build-optimization.md)
BUILD_JOBS=8
# BUILD_BIND_MOUNT=1          # macOS only
# LWS_HMI_DOCKER_VOLUME=lws-hmi-sdk

# Team cache for large downloads (not in git). See docs/cache-mirror.md
# LWS_HMI_CACHE_ROOT=/Volumes/nas/lws-hmi-cache
# LWS_HMI_CACHE_URL=https://nas.example.com/lws-hmi-cache   # optional HTTP mirror
# LWS_HMI_CACHE_PUBLISH=1     # 0 = never write to NAS (read-only mirror)
