[Unit]
Description=Innohi MainServer (ynh960 display param daemon)
DefaultDependencies=yes
After=param-update.service local-fs.target
Wants=param-update.service
Before=hmi.service
# Board-only: MIPI/LCD ParamUpdate companion. P3.2 QEMU uses virtio-gpu — no MainServer.
ConditionKernelCommandLine=!lws.emulator=1

[Service]
Type=simple
ExecStart=/usr/bin/MainServer
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
