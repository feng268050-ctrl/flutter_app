# P3.2 virt guest fragment — merge into qemu_aarch64 / virt Buildroot.
# Intentionally omits Rockchip Mali / AIC / NPU / private1 lcd chain.
# Reuse device-shaped userspace where Buildroot symbols exist.

BR2_PACKAGE_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DESKTOP_SHELL=y
BR2_PACKAGE_LIBOPENSSL=y
BR2_PACKAGE_LIBOPENSSL_BIN=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_DROPBEAR=n

# Prefer virtio / generic input; gpio-sim via kernel fragment when available.
# BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES add board/virt/linux-virt.fragment
