[Unit]
Description=LWS HMI A/B try-boot confirm / rollback
Documentation=file:///usr/libexec/ab/ab-boot-confirm.sh
DefaultDependencies=no
After=local-fs.target hmi.service
Wants=hmi.service
# P3.2 QEMU: no GPT A/B PARTLABELs / misc marker on virtio rootfs.
ConditionKernelCommandLine=!lws.emulator=1

[Service]
Type=oneshot
RemainAfterExit=yes
# Fresh boot (try_boot unset) exits 0 immediately; armed try waits for hmi.
ExecStart=/usr/libexec/ab/ab-boot-confirm.sh
TimeoutStartSec=180
# Do not block multi-user if confirm hits a transient misc read glitch.
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
