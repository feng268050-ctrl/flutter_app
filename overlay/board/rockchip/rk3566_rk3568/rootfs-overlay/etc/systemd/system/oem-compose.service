[Unit]
Description=Compose OEM board/screen pack into /run/hmi
DefaultDependencies=no
After=param-update.service local-fs.target
Before=hmi.service mainserver.service
# Device: param-update mounts /oem. Emulator: that unit is conditioned out;
# After= is still satisfied, and oem-compose mounts /dev/vdb itself.
Wants=param-update.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/oem/oem-compose.sh
# Do not use journal alone — early boot can stall if journald is not ready yet.
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
