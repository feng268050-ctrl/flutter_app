<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 核心：设置图标宽高（根据需求调整，如 24dp） -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="center"> <!-- 居中显示，避免偏移 -->
        <!-- 引用你的状态选择器 -->
        <selector >
            <!--    启用状态-->
            <item android:state_enabled="true" android:drawable="@mipmap/laser_enable_orange"/>
            <!--    禁用状态-->
            <item android:state_enabled="false" >
                <bitmap
                    android:src="@mipmap/laser_enable_orange"
                    android:alpha="0.5" />
            </item>
        </selector>
    </item>
</layer-list>
