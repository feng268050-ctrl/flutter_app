<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".activitys.device.monitor.fragment.StatisticFragment">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <!--参数值-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:id="@+id/data_layout"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:id="@+id/data_valueData"
                        android:textColor="#FFFFFF"
                        android:textSize="69sp"
                        android:textStyle="bold"
                        android:singleLine="false"
                        android:breakStrategy="balanced"
                        android:maxLines="4"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeMaxTextSize="64sp"
                        android:autoSizeStepGranularity="1sp"
                        android:paddingHorizontal="5dp"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:id="@+id/data_unit"
                        android:layout_marginStart="-6dp"
                        android:translationY="6dp"
                        android:textColor="#FFFFFF"
                        android:textSize="37sp"
                        android:gravity="center_vertical"
                        android:textStyle="bold"
                        />
                </LinearLayout>

                <com.lasercyber.lws.ui.common.view.SemiCircleProgressView
                    android:layout_width="200dp"
                    android:layout_height="124dp"
                    android:layout_marginLeft="24dp"
                    android:id="@+id/progress"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="20dp" />

                    <!--参数标题-->
                <TextView
                    android:layout_width="170dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="-9dp"
                    android:id="@+id/desc"
                    android:textColor="#ffffffff"
                    android:textSize="25sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeStepGranularity="1sp"
                    />
            </LinearLayout>
    </FrameLayout>

</layout>