# lws-hmi production overrides on top of rockchip base/base.config (§3.6 方案 A).

# No USB adb in production; use hidden SSH (§7.7).
# BR2_PACKAGE_ANDROID_ADBD is not set

# Full-screen HMI; enable getty only on dev images.
# BR2_TARGET_GENERIC_GETTY is not set

# Optional trims (uncomment if hardware has no use case):
# BR2_PACKAGE_INPUT_EVENT_DAEMON is not set
# BR2_PACKAGE_USBMOUNT is not set
# BR2_PACKAGE_PM_UTILS is not set
