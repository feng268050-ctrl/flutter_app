+++ b/src/user_input.c
@@ -9,9 +9,12 @@
 
 #include <fcntl.h>
 #include <sys/stat.h>
+#include <time.h>
 #include <sys/types.h>
 #include <unistd.h>
 
+#include <string.h>
+
 #include <libinput.h>
 #include <linux/input-event-codes.h>
 #include <memory.h>
@@ -19,6 +22,7 @@
 
 #include "compositor_ng.h"
 #include "flutter-pi.h"
+#include "cursor.h"
 #include "keyboard.h"
 #include "util/collection.h"
 #include "util/logging.h"
@@ -29,6 +33,29 @@
 #define KEY_REPEAT_DELAY_USEC (660ULL * 1000ULL)
 #define KEY_REPEAT_INTERVAL_USEC (40ULL * 1000ULL)
 
+#define LWS_MOUSE_CONF_PATH "/var/lib/lws-hmi/mouse.conf"
+#define LWS_MOUSE_MAX_POINTER_DEVICES 16
+#define LWS_MOUSE_SCROLL_BASE (53.0 / 15.0)
+
+/* Default 20 so ynh960 (low DPR) does not pick a tiny mdpi cursor. */
+static int g_lws_mouse_pointer_size = 20;
+
+void lws_mouse_set_pointer_size_percent(int percent) {
+    if (percent < 0) {
+        percent = 0;
+    } else if (percent > 100) {
+        percent = 100;
+    }
+    g_lws_mouse_pointer_size = percent;
+}
+
+double lws_mouse_cursor_select_pixel_ratio(double window_pixel_ratio) {
+    (void) window_pixel_ratio;
+    /* 0 → ~1.25 (ldpi), 50 → ~4.0, 100 → ~6.67 (xxxhdpi) */
+    return 1.25 + (g_lws_mouse_pointer_size / 100.0) * (6.6666 - 1.25);
+}
+
+
 struct input_device_data {
     struct keyboard_state *keyboard_state;
     int64_t buttons;
@@ -108,8 +135,229 @@
     uint8_t repeat_utf8[5];
     bool has_utf8;
     bool has_keysym;
+
+    /* lws-hmi mouse OS prefs (mouse.conf + libinput apply) */
+    bool mouse_natural_scroll;
+    int mouse_scroll_speed;
+    int mouse_pointer_speed;
+    int mouse_pointer_size;
+    bool mouse_left_handed;
+    struct libinput_device *mouse_pointer_devices[LWS_MOUSE_MAX_POINTER_DEVICES];
+    size_t n_mouse_pointer_devices;
+    sd_event_source *mouse_prefs_timer;
+    struct timespec mouse_conf_mtime;
 };
 
+
+static void mouse_prefs_set_defaults(struct user_input *input) {
+    input->mouse_natural_scroll = false;
+    input->mouse_scroll_speed = 50;
+    input->mouse_pointer_speed = 50;
+    input->mouse_pointer_size = 20;
+    input->mouse_left_handed = false;
+}
+
+static int mouse_clamp_percent(int v) {
+    if (v < 0) {
+        return 0;
+    }
+    if (v > 100) {
+        return 100;
+    }
+    return v;
+}
+
+static void mouse_prefs_load(struct user_input *input) {
+    FILE *f;
+    char line[256];
+
+    assert(input != NULL);
+    mouse_prefs_set_defaults(input);
+
+    f = fopen(LWS_MOUSE_CONF_PATH, "r");
+    if (f == NULL) {
+        lws_mouse_set_pointer_size_percent(input->mouse_pointer_size);
+        return;
+    }
+
+    while (fgets(line, sizeof(line), f) != NULL) {
+        char key[64];
+        char value[64];
+        char *eq;
+        char *p = line;
+
+        while (*p == ' ' || *p == '\t') {
+            p++;
+        }
+        if (*p == '#' || *p == '\n' || *p == '\0') {
+            continue;
+        }
+        eq = strchr(p, '=');
+        if (eq == NULL) {
+            continue;
+        }
+        *eq = '\0';
+        strncpy(key, p, sizeof(key) - 1);
+        key[sizeof(key) - 1] = '\0';
+        strncpy(value, eq + 1, sizeof(value) - 1);
+        value[sizeof(value) - 1] = '\0';
+        for (char *t = value; *t; t++) {
+            if (*t == '\n' || *t == '\r') {
+                *t = '\0';
+                break;
+            }
+        }
+
+        if (strcmp(key, "natural_scroll") == 0) {
+            input->mouse_natural_scroll = (strcmp(value, "1") == 0 || strcmp(value, "true") == 0);
+        } else if (strcmp(key, "scroll_speed") == 0) {
+            input->mouse_scroll_speed = mouse_clamp_percent(atoi(value));
+        } else if (strcmp(key, "pointer_speed") == 0) {
+            input->mouse_pointer_speed = mouse_clamp_percent(atoi(value));
+        } else if (strcmp(key, "pointer_size") == 0) {
+            input->mouse_pointer_size = mouse_clamp_percent(atoi(value));
+        } else if (strcmp(key, "primary_button") == 0) {
+            input->mouse_left_handed = (strcmp(value, "right") == 0);
+        }
+    }
+
+    fclose(f);
+    lws_mouse_set_pointer_size_percent(input->mouse_pointer_size);
+
+    LOG_DEBUG(
+        "mouse prefs: natural=%d scroll=%d pointer_speed=%d pointer_size=%d left_handed=%d\n",
+        input->mouse_natural_scroll ? 1 : 0,
+        input->mouse_scroll_speed,
+        input->mouse_pointer_speed,
+        input->mouse_pointer_size,
+        input->mouse_left_handed ? 1 : 0
+    );
+}
+
+static void mouse_prefs_apply_device(struct user_input *input, struct libinput_device *device) {
+    double accel;
+
+    assert(input != NULL);
+    assert(device != NULL);
+
+    if (!libinput_device_has_capability(device, LIBINPUT_DEVICE_CAP_POINTER)) {
+        return;
+    }
+
+    if (libinput_device_config_scroll_has_natural_scroll(device)) {
+        libinput_device_config_scroll_set_natural_scroll_enabled(device, input->mouse_natural_scroll ? 1 : 0);
+    }
+
+    if (libinput_device_config_accel_is_available(device)) {
+        accel = (input->mouse_pointer_speed / 100.0) * 2.0 - 1.0;
+        libinput_device_config_accel_set_speed(device, accel);
+    }
+
+    if (libinput_device_config_left_handed_is_available(device)) {
+        libinput_device_config_left_handed_set(device, input->mouse_left_handed ? 1 : 0);
+    }
+}
+
+static void mouse_prefs_track_device(struct user_input *input, struct libinput_device *device) {
+    size_t i;
+
+    if (!libinput_device_has_capability(device, LIBINPUT_DEVICE_CAP_POINTER)) {
+        return;
+    }
+
+    for (i = 0; i < input->n_mouse_pointer_devices; i++) {
+        if (input->mouse_pointer_devices[i] == device) {
+            mouse_prefs_apply_device(input, device);
+            return;
+        }
+    }
+
+    if (input->n_mouse_pointer_devices >= LWS_MOUSE_MAX_POINTER_DEVICES) {
+        LOG_ERROR("Too many pointer devices to track for mouse prefs.\n");
+        mouse_prefs_apply_device(input, device);
+        return;
+    }
+
+    input->mouse_pointer_devices[input->n_mouse_pointer_devices++] = libinput_device_ref(device);
+    mouse_prefs_apply_device(input, device);
+}
+
+static void mouse_prefs_untrack_device(struct user_input *input, struct libinput_device *device) {
+    size_t i;
+
+    for (i = 0; i < input->n_mouse_pointer_devices; i++) {
+        if (input->mouse_pointer_devices[i] == device) {
+            libinput_device_unref(device);
+            input->mouse_pointer_devices[i] =
+                input->mouse_pointer_devices[input->n_mouse_pointer_devices - 1];
+            input->n_mouse_pointer_devices--;
+            return;
+        }
+    }
+}
+
+static void mouse_prefs_apply_all(struct user_input *input) {
+    size_t i;
+
+    for (i = 0; i < input->n_mouse_pointer_devices; i++) {
+        mouse_prefs_apply_device(input, input->mouse_pointer_devices[i]);
+    }
+}
+
+#define LWS_MOUSE_PREF_POLL_USEC (1000ULL * 1000ULL)
+
+static bool mouse_conf_mtime_get(struct timespec *out) {
+    struct stat st;
+
+    assert(out != NULL);
+    if (stat(LWS_MOUSE_CONF_PATH, &st) != 0) {
+        out->tv_sec = 0;
+        out->tv_nsec = 0;
+        return false;
+    }
+    /* Second resolution is enough for 1 Hz poll. */
+    out->tv_sec = st.st_mtime;
+    out->tv_nsec = 0;
+    return true;
+}
+
+static bool mouse_conf_mtime_changed(struct user_input *input) {
+    struct timespec now;
+
+    mouse_conf_mtime_get(&now);
+    if (now.tv_sec != input->mouse_conf_mtime.tv_sec || now.tv_nsec != input->mouse_conf_mtime.tv_nsec) {
+        input->mouse_conf_mtime = now;
+        return true;
+    }
+    return false;
+}
+
+static int on_mouse_prefs_timer(sd_event_source *s, uint64_t usec, void *userdata) {
+    struct user_input *input = userdata;
+    (void) s;
+    (void) usec;
+
+    if (mouse_conf_mtime_changed(input)) {
+        int prev_size = input->mouse_pointer_size;
+        mouse_prefs_load(input);
+        mouse_prefs_apply_all(input);
+        if (prev_size != input->mouse_pointer_size && input->n_cursor_devices > 0) {
+            /* Force HW cursor re-create with new icon density. */
+            input->interface.on_set_cursor_enabled(input->userdata, false);
+            input->interface.on_set_cursor_enabled(input->userdata, true);
+        }
+    }
+
+    if (input->mouse_prefs_timer != NULL && input->event_loop != NULL) {
+        uint64_t next = 0;
+        if (sd_event_now(input->event_loop, CLOCK_MONOTONIC, &next) >= 0) {
+            sd_event_source_set_time(input->mouse_prefs_timer, next + LWS_MOUSE_PREF_POLL_USEC);
+            sd_event_source_set_enabled(input->mouse_prefs_timer, SD_EVENT_ONESHOT);
+        }
+    }
+    return 0;
+}
+
 static inline FlutterPointerEvent make_touch_event(FlutterPointerPhase phase, size_t timestamp, struct vec2f pos, int32_t device_id) {
     FlutterPointerEvent event;
     memset(&event, 0, sizeof(event));
@@ -467,6 +715,12 @@
     memset(input->repeat_utf8, 0, sizeof(input->repeat_utf8));
     input->has_utf8 = false;
     input->has_keysym = false;
+
+    input->n_mouse_pointer_devices = 0;
+    memset(input->mouse_pointer_devices, 0, sizeof(input->mouse_pointer_devices));
+    input->mouse_prefs_timer = NULL;
+    mouse_conf_mtime_get(&input->mouse_conf_mtime);
+    mouse_prefs_load(input);
 
     if (event_loop != NULL) {
         ok = sd_event_add_time(
@@ -488,6 +742,26 @@
             LOG_ERROR("Could not disable key repeat timer. sd_event_source_set_enabled: %s\n", strerror(-ok));
             goto fail_unref_repeat_timer;
         }
+
+        {
+            uint64_t now = 0;
+            ok = sd_event_add_time(
+                event_loop,
+                &input->mouse_prefs_timer,
+                CLOCK_MONOTONIC,
+                UINT64_MAX,
+                0,
+                on_mouse_prefs_timer,
+                input
+            );
+            if (ok < 0) {
+                LOG_ERROR("Could not create mouse prefs poll timer. sd_event_add_time: %s\n", strerror(-ok));
+                input->mouse_prefs_timer = NULL;
+            } else if (sd_event_now(event_loop, CLOCK_MONOTONIC, &now) >= 0) {
+                sd_event_source_set_time(input->mouse_prefs_timer, now + LWS_MOUSE_PREF_POLL_USEC);
+                sd_event_source_set_enabled(input->mouse_prefs_timer, SD_EVENT_ONESHOT);
+            }
+        }
     }
 
     return input;
@@ -556,6 +830,15 @@
         sd_event_source_unref(input->repeat_timer);
         input->repeat_timer = NULL;
     }
+    if (input->mouse_prefs_timer != NULL) {
+        sd_event_source_unref(input->mouse_prefs_timer);
+        input->mouse_prefs_timer = NULL;
+    }
+    while (input->n_mouse_pointer_devices > 0) {
+        input->n_mouse_pointer_devices--;
+        libinput_device_unref(input->mouse_pointer_devices[input->n_mouse_pointer_devices]);
+        input->mouse_pointer_devices[input->n_mouse_pointer_devices] = NULL;
+    }
 
     if (input->kbdcfg != NULL) {
         keyboard_config_destroy(input->kbdcfg);
@@ -735,6 +1018,7 @@
 
         // reserve one id for the mouse pointer
         // input->next_unused_flutter_device_id++;
+        mouse_prefs_track_device(input, device);
     }
 
     if (libinput_device_has_capability(device, LIBINPUT_DEVICE_CAP_TOUCH)) {
@@ -1265,7 +1549,10 @@
             pos_view,
             input->cursor_flutter_device_id,
             kFlutterPointerSignalKindScroll,
-            VEC2F(scroll_x / 15.0 * 53.0, scroll_y / 15.0 * 53.0),
+            VEC2F(
+                scroll_x * LWS_MOUSE_SCROLL_BASE * (0.25 + (input->mouse_scroll_speed / 100.0) * 1.75),
+                scroll_y * LWS_MOUSE_SCROLL_BASE * (0.25 + (input->mouse_scroll_speed / 100.0) * 1.75)
+            ),
             data->buttons
         )
     );
