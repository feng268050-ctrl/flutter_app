+// Spike-only present counter (E0.5 frame-pacing seal). Emits one line per
+// wall-clock second: ELINUX_PRESENT_FPS <n>
+void NotePresentSuccess() {
+  static std::atomic<unsigned> count{0};
+  static std::atomic<std::time_t> bucket{0};
+  const std::time_t now = std::time(nullptr);
+  std::time_t prev = bucket.load(std::memory_order_relaxed);
+  if (now != prev) {
+    if (bucket.compare_exchange_strong(prev, now, std::memory_order_acq_rel)) {
+      const unsigned n = count.exchange(0, std::memory_order_acq_rel);
+      // prev==0 on first tick — skip partial bucket.
+      if (prev != 0) {
+        std::fprintf(stderr, "ELINUX_PRESENT_FPS %u\n", n);
+        std::fflush(stderr);
+      }
+    }
+  }
+  count.fetch_add(1, std::memory_order_relaxed);
+}
+}  // namespace
