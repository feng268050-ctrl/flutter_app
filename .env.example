# Copy to .env and adjust (do not commit .env).
# Release signing — defaults match local platform.jks convention when unset.
# SIGNING_STORE_FILE may be absolute, or relative to the repository root (not app/).
SIGNING_STORE_FILE=platform.jks
SIGNING_STORE_PASSWORD=android
SIGNING_KEY_ALIAS=android
SIGNING_KEY_PASSWORD=android

# Required by 'make emulator': written as sn= to /system/etc/model.properties (runtime SN injection when YNHAPI has no serial).
# SN=54b515de0f9d06f2

# Optional: written as camera_ip= to /system/etc/model.properties (make emulator/prepare).
# Physical tablet: camera_ip = IPC eth0 address (e.g. 192.168.0.237).
# Emulator sharing tablet camera: camera_ip = tablet Wi‑Fi IP (HTTP port 9000 via CameraLanHttpProxy).
# CAMERA_IP=192.168.1.100

# Optional: written as camera_type= to /system/etc/model.properties (make emulator/prepare).
# 1 = BLUE_LIGHT (蓝光, default); 2 = RED_LIGHT (红光).
# CAMERA_TYPE=1

# Optional: written as focus_scale_ref= to /system/etc/model.properties (make emulator/prepare).
# Gun-head focus scale reference shown in laser-enable Important Reminder dialog; default 0.
# FOCUS_SCALE_REF=0

# Optional: written as control_card_comm_alarm_mode= to /system/etc/model.properties (make emulator/prepare).
# slide_window = ≥3 failures in last 5 Modbus polls (default); immediate = alarm on latest failed poll.
# CONTROL_CARD_COMM_ALARM_MODE=slide_window

# Optional: written as host_ip= to /system/etc/model.properties (make emulator).
# Auto-detected from dev host default-route LAN IPv4 when unset; override when multi-homed/VPN.
# HOST_IP=192.168.1.50

# Optional: select adb device when multiple are connected (see scripts/ci/*.sh).
# ADB_SERIAL=0123456789abcdef

# ADB_SERIAL=3d9204d2c3b32cd9
ADB_SERIAL=54b515de0f9d06f2

# Optional: old BSP / older NPU driver — set bundled AI native variant in repo-root local.properties:
#   ai.library.variant=legacy
# See docs/LENS_GUARD_APP_INTEGRATION.md § RKNN runtime vs BSP.

# Native AI build (`make ai`): auto-convert ONNX→RKNN (Docker) + build libai.so.
# Also auto-fetches OpenCV/NDK/RKNN runtime by default — no NDK/OpenCV paths in .env.
#
# Optional: skip model conversion (use existing native/lensinspector/assets/models/det_raw_head.rknn):
# SKIP_RKNN_CONVERT=1
#
# Optional: override conversion inputs (must live under ai-library/):
# RKNN_ONNX=ai-library/det_raw_head.onnx
# RKNN_CALIB_ZIP=ai-library/<calib>.zip
# RKNN_PLATFORM=rk3566
# RKNN_DTYPE=i8
# Optional (override vendored runtime):
# RKNN_RT_PATH=/path/to/rknn-toolkit2/rknpu2/runtime/Android/librknn_api/arm64-v8a
#
# Optional:
# OPENCV_PATH=...        # only if not using `make opencv`
# AI_SKIP_ROSETTA=1        # Apple Silicon: disable auto Rosetta re-exec for make ai


