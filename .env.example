# Copy to .env and adjust (do not commit .env).

# Rockchip Linux SDK path (default: ~/Downloads/rk356x_linux6.1_20250730_1126/...)
# LWS_HMI_SDK=/path/to/rk356x_linux6.1_20250730_1126

# USB flash: device selection (see make devices)
# SERIAL=0123456789abcdef
# USB_LOCATION=0x0010000000000000

# Optional firmware path override for make upgrade
# IMAGE=/path/to/update.img

# Docker build tuning (macOS defaults to JOBS=4, volume mount)
# LWS_HMI_JOBS=4
# LWS_HMI_BIND_MOUNT=1
# LWS_HMI_DOCKER_VOLUME=lws-hmi-sdk
# LWS_HMI_AUTO_PULL=1
