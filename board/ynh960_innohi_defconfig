# Innohi ynh960 — SDK native Linux (no lws_hmi Buildroot / no flutter-pi overlay).
# Uses standard rockchip_rk3566_rk3568 + mk-rootfs Innohi MainServer path.
RK_KERNEL_VERSION="6.10"
RK_KERNEL_DTS_NAME="ynh960"
# Re-enable dsi0/route_dsi0 (disabled in rk3566-evb2.dtsi) + boot logo direct show.
RK_KERNEL_CFG_FRAGMENTS="lws-hmi-ynh960-display.config"
RK_PARAMETER="parameter-buildroot-fit.txt"
RK_USE_FIT_IMG=y
# Innohi: use SDK default boot.its (kernel + dtb + resource.img) — NOT boot-slim.its
RK_BOOT_FIT_ITS_NAME="boot.its"
DEFAULT_LCD_PARAM="960_lcd_param_rk356x.txt"
# Docker/offline: skip hard-fail preflight to buildroot.net (packages use BR cache).
RK_NETWORK_CHECK=n
# No camera/rkaiq — avoids camera-engine-rkaiq iq parser build failure in sdk-native.
RK_BUILDROOT_BASE_CFG="rk3566_rk3568_innohi_native"
RK_WIFIBT=y
