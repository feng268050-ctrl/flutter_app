* text=auto
*.sh text eol=lf
Makefile text eol=lf

# Large prebuilt artifacts (optional Git LFS — run: git lfs install && git lfs track)
prebuilt/flutter-sdk/install/** filter=lfs diff=lfs merge=lfs -text
prebuilt/flutter-engine/**/libflutter_engine.so filter=lfs diff=lfs merge=lfs -text
prebuilt/flutter-engine/**/gen_snapshot filter=lfs diff=lfs merge=lfs -text
prebuilt/mediamtx/**/mediamtx filter=lfs diff=lfs merge=lfs -text
prebuilt/rknn-rt/**/*.so filter=lfs diff=lfs merge=lfs -text
