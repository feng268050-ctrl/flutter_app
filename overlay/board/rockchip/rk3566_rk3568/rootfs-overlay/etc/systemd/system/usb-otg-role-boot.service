[Unit]
Description=Apply Micro-USB OTG mode at boot
DefaultDependencies=no
After=sysinit.target systemd-udev-settle.service
Before=multi-user.target

[Service]
Type=oneshot
# Policy is static: /etc/usb-otg.ini
ExecStart=/usr/libexec/hmi/usb-otg-mode.sh apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
