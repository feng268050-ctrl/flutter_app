[Unit]
Description=Bluetooth HID input heal (Trusted HOGP/HID → uhid/evdev)
Documentation=file:///usr/libexec/bluetooth/bt-hid-heal.sh
# Deferred with bluetooth — started by bt-stack-up.sh, not WantedBy multi-user.
After=bluetooth.service dbus.service
Requires=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/libexec/bluetooth/bt-hid-heal-loop.sh
Restart=on-failure
RestartSec=5
# Quiet journal noise; heal script logs only on action.
StandardOutput=journal
StandardError=journal

[Install]
# Intentionally empty — on-demand via bt-stack-up.sh
