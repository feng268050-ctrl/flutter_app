[Unit]
Description=Serial console geometry (ttyFIQ0)
DefaultDependencies=yes
After=dev-ttyFIQ0.device serial-getty@ttyFIQ0.service
Before=mainserver.service hmi.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/board/serial-console-stty.sh

[Install]
WantedBy=multi-user.target
