<?xml version="1.0" encoding="utf-8"?>
<!-- 橙色区：底部浅色 #FFB8B8 约 10% 不透明度（便于看出蓝色区）→ 顶部 100% 橙红 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#FFFF5520"
        android:centerColor="#E6FF7A30"
        android:endColor="#1AFFB8B8"
        android:centerY="0.4"
        android:tileMode="clamp" />
</shape>
