# ynh960 lws-hmi factory image: hash-valid FIT per rootfs letter.
# NAME	PATH
# Intentionally omit vendor0–vendor3 — Vendor Storage must survive make flash.
# Intentionally omit provision — factory tunables / properties.ini must survive make flash.
package-file	package-file
parameter	parameter.txt
bootloader	MiniLoaderAll.bin
uboot	uboot.img
misc	misc.img
boot	boot.img
boot_b	boot_b.img
# Distinct LABEL/UUID per slot (same payload). Do not point both at rootfs.img.
rootfs_a	rootfs_a.img
rootfs_b	rootfs_b.img
oem	oem.img
