# ynh960 product hardening: no USB mass storage; trim unused network protocols.
# USB gadget (g_ether plug-ssh, MTP FunctionFS, host HID) stays in ynh960-usb-gadget.config.

# Kernel 6.10+ security/Kconfig.hardening — pin syncconfig/oldconfig prompts
# (weakest stack init; heap/reg zeroing off; no KCSAN — embedded perf defaults).
CONFIG_INIT_STACK_NONE=y
# CONFIG_INIT_STACK_ALL_PATTERN is not set
# CONFIG_INIT_STACK_ALL_ZERO is not set
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
# CONFIG_ZERO_CALL_USED_REGS is not set
# CONFIG_KCSAN is not set

# USB-1000 — product does not attach external USB drives on the host port.
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_UAS is not set

# NETW-3200 — RTSP/HTTP/SSH use TCP/UDP only.
# CONFIG_IP_DCCP is not set
# CONFIG_IP_SCTP is not set
# CONFIG_RDS is not set
# CONFIG_TIPC is not set
