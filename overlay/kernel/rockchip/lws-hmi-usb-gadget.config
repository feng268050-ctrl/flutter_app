# Default ynh960 USB gadget (ECM) for plug-to-ssh debug (make push-app).
# Replaces optional lws-hmi-debug-usb.config — FunctionFS/FF intentionally omitted.
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_VBUS_DRAW=500
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_ETH=y
CONFIG_USB_F_ECM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_DWC3_ROCKCHIP=y
CONFIG_USB_ROLE_SWITCH=y
