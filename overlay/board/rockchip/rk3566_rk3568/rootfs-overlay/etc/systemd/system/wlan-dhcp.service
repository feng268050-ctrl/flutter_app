[Unit]
Description=LWS HMI on-demand wlan0 DHCP
Documentation=file:///usr/libexec/wpa/wlan0-dhcp.sh
# Not linked from multi-user.target.wants — started only via wlan0-dhcp.sh / Demo.
DefaultDependencies=no
After=local-fs.target wlan-wpa.service

[Service]
# Keep networkd apply outside hmi.service cgroup.
Type=oneshot
RemainAfterExit=yes
KillMode=none
Environment=LWS_DHCP_IN_UNIT=1
ExecStart=/usr/libexec/wpa/wlan0-dhcp.sh start
ExecStop=/usr/libexec/wpa/wlan0-dhcp.sh stop

# No [Install] — must not auto-start at boot.
