<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle"> <!-- 形状为矩形，与LinearLayout匹配 -->

    <!-- 1. 边框设置：宽度 + 颜色（核心） -->
    <stroke
        android:width="1dp"
    android:color="#7C7EAB" />

    <!-- 2. 可选：LinearLayout的背景色（若需透明，可省略此属性） -->
    <solid android:color="#3A3A3C" /> <!-- 内部背景色，与边框区分 -->

    <!-- 3. 可选：圆角（让边框带圆角，更美观） -->
    <corners android:radius="8dp" /> <!-- 圆角半径，根据需求调整 -->

    <!-- 4. 可选：内边距（避免LinearLayout的内容与边框重叠） -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />

</shape>