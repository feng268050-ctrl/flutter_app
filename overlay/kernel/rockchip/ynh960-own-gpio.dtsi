// ynh960: fix own-gpio vs gmac1 pinmux conflict; restore USB host VBUS.
//
// Under EVB RGMII, gmac1 stole gpio4 A0/A1/A2 (txclk/rxd2/rxd3) and gpio3 D7
// (txd3) — same pads as Innohi USB_HOST_PWREN* / Relay-CTL. Pinctrl then failed
// the *entire* own-gpio group. With product RMII (uart5-gmac overlay), gpio4
// A0/A1/A2 are free again → restore USB_HOST_PWREN* for 1 mm host expansion VBUS.
// Relay-CTL (gpio3 D7) still conflicts with leftover RGMII naming only if RGMII
// returns; keep Relay deleted until schematic confirms it is needed.
//
// Keep abstract GPIO_3/4/6 for P2 LEDs; default indicators off so boot is not
// full-bright.

&pinctrl {
	own_gpio {
		own_gpio_pins: own-gpio-pins {
			rockchip,pins =
				<4 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>, /* USB_HOST_PWREN1_H */
				<4 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>, /* USB_HOST_PWREN2_H */
				<4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>, /* USB_HOST_PWREN3_H */
				<0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>, /* GPIO-1 */
				<0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>, /* GPIO-2 */
				<0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>, /* GPIO-3 */
				<3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>, /* GPIO-4 yellow */
				<3 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>, /* GPIO-5 red */
				<0 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>, /* GPIO-6 */
				<4 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>, /* GPIO-7 green (silk WG_D0) */
				<4 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>, /* GPIO-8 (silk WG_D1) */
				/* Relay-CTL (gpio3 D7) still omitted — confirm vs any leftover eth mux */
				<3 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>, /* Bell-CTL */
				<0 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>, /* LED_RED */
				<0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>; /* LED_BLUE */
		};
	};
};

&own_gpio {
	/delete-node/ Relay_CTL;

	USB_HOST_PWREN1_H {
		default-value = "1";
	};
	USB_HOST_PWREN2_H {
		default-value = "1";
	};
	USB_HOST_PWREN3_H {
		default-value = "1";
	};

	GPIO_4 {
		default-value = "0";
	};
	GPIO_5 {
		default-value = "0";
	};
	GPIO_7 {
		default-value = "0";
	};
};
