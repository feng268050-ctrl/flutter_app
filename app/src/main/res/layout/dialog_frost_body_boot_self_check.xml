<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingRight="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:maxHeight="420dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/boot_self_check_item_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/boot_self_check_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/frost_dialog_content_padding"
            android:layout_marginBottom="@dimen/frost_dialog_content_padding"
            android:background="@drawable/frost_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/frost_action_button_height"
            android:orientation="horizontal">

            <com.lasercyber.lws.frostui.control.interop.FrostCheckboxView
                android:id="@+id/cb_boot_self_check_dont_show_again"
                style="@style/FrostCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:labelText="@string/boot_self_check_dont_show_again" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.lasercyber.lws.frostui.button.interop.FrostButtonView
                android:id="@+id/tv_boot_self_check_close"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/frost_action_button_height"
                android:layout_marginStart="@dimen/frost_dialog_content_padding"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/frost_action_button_padding_horizontal"
                android:paddingRight="@dimen/frost_action_button_padding_horizontal"
                android:text="@string/boot_self_check_close"
                android:textColor="@color/frost_text_primary"
                android:textSize="@dimen/frost_action_button_text_size"
                app:borderGradientCenter="top-left-bottom-right"
                app:frostedGlassButtonVariant="default" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
