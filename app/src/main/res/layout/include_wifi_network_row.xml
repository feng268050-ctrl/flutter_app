<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/tv_ssid"
        style="@style/advanced_setting_item_title"
        android:includeFontPadding="false" />

    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_connected"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/wifi_status_connected"
            android:scaleType="fitCenter"
            android:src="@mipmap/wifi_open_icon"
            android:visibility="invisible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_standard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/side_tab_not_active_color"
            android:textSize="29sp" />

        <TextView
            android:id="@+id/tv_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:textColor="@color/side_tab_not_active_color"
            android:textSize="29sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_lock"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/wifi_lock_icon" />

            <ImageView
                android:id="@+id/iv_signal"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/wifi_icon" />
        </LinearLayout>
    </LinearLayout>
</merge>
