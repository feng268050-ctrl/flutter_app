From: lws-hmi kernel overlay
Subject: 0006-rockchip-drm-skip-init-without-display-subsystem.patch

diff -ruN a/drivers/gpu/drm/rockchip/rockchip_drm_drv.c b/drivers/gpu/drm/rockchip/rockchip_drm_drv.c
--- a/drivers/gpu/drm/rockchip/rockchip_drm_drv.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_drv.c
@@ -2571,6 +2571,18 @@
 	if (drm_firmware_drivers_only())
 		return -ENODEV;
 
+	/* Same Image on QEMU virt: no Rockchip display DT → no ATF SIP. */
+	{
+		struct device_node *np;
+
+		np = of_find_compatible_node(NULL, NULL, "rockchip,display-subsystem");
+		if (!np) {
+			pr_info("rockchip-drm: no display-subsystem, skip (non-Rockchip DT)\n");
+			return -ENODEV;
+		}
+		of_node_put(np);
+	}
+
 	num_rockchip_sub_drivers = 0;
 #if IS_ENABLED(CONFIG_DRM_ROCKCHIP_VVOP)
 	ADD_ROCKCHIP_SUB_DRIVER(vvop_platform_driver, CONFIG_DRM_ROCKCHIP_VVOP);
