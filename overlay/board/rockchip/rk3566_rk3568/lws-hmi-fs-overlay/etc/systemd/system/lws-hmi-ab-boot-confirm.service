[Unit]
Description=LWS HMI A/B try-boot confirm / rollback
Documentation=file:///usr/lib/lws-hmi/ab-boot-confirm.sh
DefaultDependencies=no
After=local-fs.target hmi.service
Wants=hmi.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Fresh boot (try_boot unset) exits 0 immediately; armed try waits for hmi.
ExecStart=/usr/lib/lws-hmi/ab-boot-confirm.sh
TimeoutStartSec=180
# Do not block multi-user if confirm hits a transient misc read glitch.
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
