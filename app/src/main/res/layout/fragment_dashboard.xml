<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".activitys.device.monitor.fragment.DashboardFragment">

        <FrameLayout
            android:layout_width="match_parent"
            android:background="@mipmap/custom_back"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_height="240dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="24dp"
            android:orientation="vertical"
            android:background="@mipmap/custom_back_border">

           <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="600dp">
                    <!-- 网格卡片列表 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="600dp"
                    android:clipToPadding="false"
                    android:padding="32dp" />

            </LinearLayout>

            <!-- 保存按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="-100dp"
                android:gravity="center">
                <com.lasercyber.lws.frostui.button.interop.FrostButtonView
                    android:id="@+id/btnSave"
                    android:layout_width="240dp"
                    android:layout_height="68dp"
                    android:text="@string/save_changes"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="29sp"
                    android:enabled="true"
                    app:frostedGlassButtonVariant="primary" />
            </LinearLayout>

        </LinearLayout>

        </LinearLayout>

    </FrameLayout>
</layout>