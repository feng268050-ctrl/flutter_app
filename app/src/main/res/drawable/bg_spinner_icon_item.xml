<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中状态 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF060720" /> <!-- 选中背景色 -->
            <corners android:radius="8dp" /> <!-- 圆角 -->
            <stroke
                android:width="1dp"
                android:color="#2196F3" /> <!-- 选中边框色 -->
        </shape>
    </item>
    <!-- 正常状态 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF060720" /> <!-- 正常背景色 -->
            <corners android:radius="8dp" /> <!-- 圆角 -->
            <stroke
                android:width="1dp"
                android:color="#E0E0E0" /> <!-- 正常边框色 -->
        </shape>
    </item>
</selector>