# ynh960 onboard combo: AIC8800D80 (SDIO vendor 0xc8a1).
# Firmware lives under /vendor/etc/firmware (Innohi via post-wifibt).
# Modules land in /vendor/lib/modules via post-wifibt `find kernel -name '*.ko'`.
#
# cfg80211 is built-in and loads the regulatory database before rootfs is
# mounted. Ship regulatory.db{,.p7s} via EXTRA_FIRMWARE (synced from
# overlay/kernel/firmware/ by apply-overlay). Rootfs still keeps
# BR2_PACKAGE_WIRELESS_REGDB for /lib/firmware after boot.

CONFIG_EXTRA_FIRMWARE="regulatory.db regulatory.db.p7s"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"

CONFIG_AIC_WLAN_SUPPORT=y
CONFIG_AIC_FW_PATH="/vendor/etc/firmware"
CONFIG_AIC8800_WLAN_SUPPORT=m
CONFIG_AIC8800_BTLPM_SUPPORT=m
