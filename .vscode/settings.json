{
  "dart.flutterSdkPath": "flutter-sdk",
  "dart.projectSearchPaths": ["app/hmi"],
  "dart.flutterRunAdditionalArgs": ["--no-track-widget-creation"],
  "dart.analysisExcludedFolders": [
    "flutter-sdk",
    ".host-deps",
    "linux-sdk",
    "prebuilt",
    ".cache",
    "output"
  ],
  "files.watcherExclude": {
    "**/prebuilt/**": true,
    "**/flutter-sdk/**": true,
    "**/linux-sdk/**": true,
    "**/output/**": true,
    "**/.cache/**": true,
    "**/overlay/board/rockchip/rk3566_rk3568/lws-hmi-fs-overlay/opt/hmi/**": true
  },
  "search.exclude": {
    "**/prebuilt": true,
    "**/flutter-sdk": true,
    "**/linux-sdk": true,
    "**/output": true,
    "**/.cache": true
  },
  "java.import.exclusions": [
    "**/.cache/**",
    "**/.host-deps/**",
    "**/flutter-sdk/**",
    "**/linux-sdk/**",
    "**/prebuilt/**",
    "**/output/**"
  ],
  "java.project.resourceFilters": [
    "node_modules",
    "\\.git",
    "\\.cache",
    "\\.host-deps",
    "flutter-sdk",
    "linux-sdk",
    "prebuilt",
    "output"
  ],
  "java.import.gradle.enabled": false,
  "java.configuration.updateBuildConfiguration": "disabled",
  "gradle.autoDetect": "off",
  "gradle.nestedProjects": false,
  "git.ignoreLimitWarning": true,
  "java.compile.nullAnalysis.mode": "automatic",
  "dart.showTodos": false
}
