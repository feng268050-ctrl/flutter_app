	/*
	 * Live FDT named panel-exit-sequence = <0x05780111 0x051e0129>
	 * (sleep-out / display-on) — almost certainly mislabeled; init already
	 * ends with 0x11 / 0x29. Use standard display-off / sleep-in here.
	 */
	panel-exit-sequence = [
		05 00 01 28
		05 00 01 10
	];

	display-timings {
		native-mode = <&ek3562_mipi_timing>;
		ek3562_mipi_timing: timing {
			clock-frequency = <67000000>;
			hactive = <800>;
			vactive = <1280>;
			hfront-porch = <18>;
			hsync-len = <18>;
			hback-porch = <18>;
