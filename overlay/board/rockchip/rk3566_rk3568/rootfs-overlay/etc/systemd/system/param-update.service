[Unit]
Description=ynh960 MIPI display init (Innohi MountAll/ParamUpdate)
DefaultDependencies=no
After=systemd-remount-fs.service
Before=mainserver.service hmi.service sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/lws-hmi/ynh960-display-init.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
