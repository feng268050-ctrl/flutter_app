# lws-hmi network stack: override rockchip network/network.config bloat (§3.6.3).
# wireless.config still pulls wpa_supplicant via wifibt/wireless.config.
# P3.1 / D11: L3 = systemd-networkd (see lws_hmi_systemd.config); do not co-manage with dhcpcd.
# Wi‑Fi L2: wpa D-Bus (-u) + keep CLI/ctrl_iface from wireless.config for wpa_cli.

# BR2_PACKAGE_CHRONY is not set
# BR2_PACKAGE_DHCPCD is not set
# BR2_PACKAGE_DNSMASQ is not set
# BR2_PACKAGE_DROPBEAR is not set
# BR2_PACKAGE_GESFTPSERVER is not set

# Rebuilds wpa_supplicant with CONFIG_CTRL_IFACE_DBUS_NEW (run-wpa.sh passes -u).
# Selects dbus (already pulled by BT); CLI/ctrl_iface stay on for helpers.
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y

# HTTPS trust store for Dart HttpClient Demo probe (and later P5 cloud).
# Without this, https://… fails with CERTIFICATE_VERIFY_FAILED / unable to get local issuer.
BR2_PACKAGE_CA_CERTIFICATES=y

# P2.2 date/time: IANA zones for Demo/Settings (UTC + Asia/Shanghai minimum).
# systemd-timesyncd / chrony stay off — network sync uses rdate / HTTP Date helper.
BR2_PACKAGE_TZDATA=y

BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IPUTILS=y

# SSH for §7.7 hidden debug; unit disabled in 06-systemd.sh.
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_CLIENT=y
BR2_PACKAGE_OPENSSH_SERVER=y
