From: lws-hmi kernel overlay
Subject: 0013-mfd-rk808-rk809-poweroff-slppin-before-device-shutdown.patch

mfd: rk808: RK809 soft power-off via DEV_OFF so PWRON can cold-boot

ynh960: SysRq poweroff left PMIC ON (off=0x00, on=ON_PLUG_IN after unplug).
RK817 SYS_CFG3 bit0 is DEV_OFF; vendor shutdown skipped RK809/817. Also
run prepare before device_shutdown and register syscore for SLPPIN/DEV_OFF.

---
 drivers/mfd/rk808.c | 60 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed

diff --git a/drivers/mfd/rk808.c b/drivers/mfd/rk808.c
--- a/drivers/mfd/rk808.c
+++ b/drivers/mfd/rk808.c
@@ -906,9 +906,9 @@
 		ret = regmap_update_bits(rk808->regmap,
 					 RK817_SYS_CFG(3),
 					 RK817_SLPPOL_MSK,
-					 RK817_SLPPOL_H);
+					 RK817_SLPPOL_L);
 		if (ret)
-			pr_err("shutdown: config RK817_SLPPOL_H error!\n");
+			pr_err("shutdown: config RK817_SLPPOL_L error!\n");
 
 		ret = pinctrl_select_state(rk808->pins->p,
 					   rk808->pins->power_off);
@@ -923,6 +923,17 @@
 				 RK817_SLPPIN_FUNC_MSK, SLPPIN_DN_FUN);
 	if (ret)
 		dev_err(&rk808_i2c_client->dev, "Failed to shutdown device!\n");
+
+	/*
+	 * RK809/RK817 SYS_CFG3 bit0 is DEV_OFF. SLPPIN alone does not latch
+	 * OFF_SLP on ynh960 after 6.1.180; DEV_OFF does real PMIC power-off
+	 * so PWRON can cold-boot (OFF_DEV_OFF).
+	 */
+	ret = regmap_update_bits(rk808->regmap, RK817_SYS_CFG(3),
+				 DEV_OFF, DEV_OFF);
+	if (ret)
+		dev_err(&rk808_i2c_client->dev, "Failed to set DEV_OFF!\n");
+
 	/* pmic need the SCL clock to synchronize register */
 	mdelay(2);
 	return ret;
@@ -1005,6 +1016,12 @@
 				dev_warn(&rk808_i2c_client->dev,
 					 "Cannot switch to power down function\n");
 			}
+			ret = regmap_update_bits(rk808->regmap, RK817_SYS_CFG(3),
+						 DEV_OFF, DEV_OFF);
+			if (ret) {
+				dev_warn(&rk808_i2c_client->dev,
+					 "Cannot set DEV_OFF\n");
+			}
 		}
 
 		if (pm_shutdown) {
@@ -1216,6 +1233,13 @@
 		dev_info(dev, "reboot: not restore POWER_EN\n");
 	}
 
+	if (action == SYS_POWER_OFF || action == SYS_HALT) {
+		struct sys_off_data off = { .cb_data = data->rk808 };
+
+		rk817_shutdown_prepare(&off);
+		return NOTIFY_OK;
+	}
+
 	if (action != SYS_RESTART || !cmd)
 		return NOTIFY_OK;
 
@@ -1576,6 +1600,9 @@
 			register_syscore_ops(&rk808_syscore_ops);
 			/* power off system in the syscore shutdown ! */
 			pm_shutdown = device_shutdown_fn;
+		} else if (rk808->variant == RK809_ID ||
+			   rk808->variant == RK817_ID) {
+			register_syscore_ops(&rk808_syscore_ops);
 		}
 	}
 
