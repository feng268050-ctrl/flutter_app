From: lws-hmi <lws-hmi@local>
Subject: [PATCH] firmware: rockchip_sip: do not SMC without Rockchip DT

Rockchip SIP helpers always emit `smc` (EL3/ATF). QEMU virt uses PSCI
via HVC and has no Rockchip ATF; an unconditional SMC is UND and panics
(e.g. rockchip_gem_get_ddr_info during DRM init).

If the root DT compatible list has no "rockchip,*" entry, return
SIP_RET_NOT_SUPPORTED instead of invoking SMC. Device trees for this
product line keep rockchip,rk3566 / rk3568 on the root node.

--- a/drivers/firmware/rockchip_sip.c
+++ b/drivers/firmware/rockchip_sip.c
@@ -34,6 +34,7 @@
 #include <linux/arm-smccc.h>
 #include <linux/io.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/rockchip/rockchip_sip.h>
 #include <asm/cputype.h>
 #ifdef CONFIG_ARM
@@ -55,12 +56,43 @@
 
 #define SIZE_PAGE(n)	((n) << 12)
 
+static bool rockchip_sip_el3_present(void)
+{
+	static int cached = -1;
+	struct device_node *root;
+	struct property *prop;
+	const char *compat;
+
+	if (likely(cached >= 0))
+		return cached;
+
+	cached = 0;
+	root = of_find_node_by_path("/");
+	if (!root)
+		return false;
+
+	of_property_for_each_string(root, "compatible", prop, compat) {
+		if (compat && !strncmp(compat, "rockchip,", 9)) {
+			cached = 1;
+			break;
+		}
+	}
+	of_node_put(root);
+	return cached;
+}
+
 static struct arm_smccc_res __invoke_sip_fn_smc(unsigned long function_id,
 						unsigned long arg0,
 						unsigned long arg1,
 						unsigned long arg2)
 {
 	struct arm_smccc_res res;
 
+	if (!rockchip_sip_el3_present()) {
+		res.a0 = SIP_RET_NOT_SUPPORTED;
+		res.a1 = res.a2 = res.a3 = 0;
+		return res;
+	}
+
 	arm_smccc_smc(function_id, arg0, arg1, arg2, 0, 0, 0, 0, &res);
 	return res;
 }
