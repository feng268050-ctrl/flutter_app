[Unit]
Description=LWS HMI on-demand LAN/WLAN SSH debug
Documentation=file:///usr/libexec/ssh/enable-ssh-debug.sh
# Not linked from multi-user.target.wants — started only via enable-ssh-debug.sh / Demo.
DefaultDependencies=no
After=local-fs.target

[Service]
# Foreground sshd via lan-ssh-run.sh: listens only on eth0/wlan0 IPs so USB-SSH
# can keep ListenAddress=192.168.55.1 on a separate process.
Type=simple
ExecStart=/usr/libexec/ssh/lan-ssh-run.sh
Restart=no

# No [Install] — must not auto-start at boot.
