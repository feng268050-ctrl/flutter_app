# SELinux userspace for Cyber OS (permissive first).
# Kernel LSM: overlay/kernel/rockchip/ynh960-selinux.config
# Buildroot labels the rootfs via host setfiles when REFPOLICY is enabled.
# Do not enable Enforcing here — product domains (HMI/AI/MediaMTX) are a
# follow-up change after AVC soak.

BR2_PACKAGE_LIBSELINUX=y
BR2_PACKAGE_REFPOLICY=y
BR2_PACKAGE_REFPOLICY_POLICY_STATE_PERMISSIVE=y
# sestatus / setfiles / load_policy for on-device verify (libselinux also
# installs getenforce/setenforce utilities).
BR2_PACKAGE_POLICYCOREUTILS=y
# auditd for Lynis ACCT-9628 + SELinux AVC collection (kernel CONFIG_AUDIT=y).
BR2_PACKAGE_AUDIT=y
