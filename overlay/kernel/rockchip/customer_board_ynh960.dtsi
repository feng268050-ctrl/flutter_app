#include "ynh960-usb-host.dtsi" /* ynh960 overlay */

#include "ynh960-evb-trim.dtsi" /* ynh960 overlay */

#include "ynh960-touch.dtsi" /* ynh960 overlay */

#include "ynh960-own-gpio.dtsi" /* ynh960 overlay */

#include "ynh960-uart5-gmac.dtsi" /* ynh960 overlay */

#include "ynh960-uart7-pwm.dtsi" /* ynh960 overlay */

