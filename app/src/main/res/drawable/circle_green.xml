<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">  <!-- 形状为椭圆（宽高相等时即为圆形） -->

    <!-- 填充绿色 -->
    <solid android:color="#00FF00"/>  <!-- 纯绿色，可改为 #32CD32（森林绿）等 -->

    <!-- 可选：添加边框 -->
  <stroke
        android:width="1dp"
        android:color="#FFFFFF"/>
    <!-- 白色边框 -->


    <!-- 可选：添加阴影（API 21+） -->
     <padding
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"/>
    <solid android:color="#00FF00"/>
    <corners android:radius="6dp"/>  <!-- 与宽高一半一致 -->
    <elevation android:elevation="2dp"/>  <!-- 阴影高度 -->

</shape>