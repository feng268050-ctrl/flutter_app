# ynh960 A-3 kernel trim: remove unused EVB/development-board drivers.
# Keep HDMI (mini HDMI present), USB, audio, filesystems, Wi-Fi/BT, eth0,
# RKNPU, MPP/RGA, DSI display, touch (see ynh960-touch.config), and
# serial debugging.

# No CAN/CAN-FD hardware path in the ynh960 product.
# CONFIG_CAN is not set
# CONFIG_CAN_DEV is not set
# CONFIG_CAN_ROCKCHIP is not set
# CONFIG_CANFD_ROCKCHIP is not set
# CONFIG_CANFD_RK3576 is not set

# No PCIe/NVMe/SATA/UFS storage path; rootfs is eMMC. USB mass storage host
# is disabled in ynh960-hardening.config (product does not use thumb drives).
# CONFIG_PCI is not set
# CONFIG_PCIEPORTBUS is not set
# CONFIG_PCIE_ROCKCHIP is not set
# CONFIG_PCIE_ROCKCHIP_HOST is not set
# CONFIG_PCIE_DW_ROCKCHIP is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NVME_CORE is not set
# CONFIG_ATA is not set
# CONFIG_SATA_HOST is not set
# CONFIG_SATA_AHCI is not set
# CONFIG_AHCI_DWC is not set
# CONFIG_SCSI_UFSHCD is not set
# CONFIG_SCSI_UFSHCD_PLATFORM is not set
# CONFIG_SCSI_UFS_ROCKCHIP is not set

# No local CSI camera, TV/radio/SDR, or DVB/tuner product path.
# IPC video arrives over eth0 RTSP and uses MPP/RGA/GStreamer, which stay enabled.
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
# CONFIG_DVB_CORE is not set
# CONFIG_DVB_NET is not set
# CONFIG_RADIO_ADAPTERS is not set
# CONFIG_MEDIA_TUNER is not set
# CONFIG_CXD2880_SPI_DRV is not set
# CONFIG_VIDEO_ROCKCHIP_CIF is not set
# CONFIG_VIDEO_ROCKCHIP_RKISP1 is not set
# CONFIG_VIDEO_ROCKCHIP_ISP is not set
# CONFIG_VIDEO_ROCKCHIP_ISPP is not set
# CONFIG_VIDEO_ROCKCHIP_HDMIRX_CLASS is not set
# CONFIG_VIDEO_ROCKCHIP_HDMIRX is not set
# CONFIG_VIDEO_ROCKCHIP_VPSS is not set
# CONFIG_VIDEO_RK628 is not set
# CONFIG_VIDEO_RK628_CSI is not set
# CONFIG_VIDEO_RK628_BT1120 is not set
# CONFIG_VIDEO_RK_IRCUT is not set

# ynh960 uses MIPI DSI plus mini HDMI. Drop other Rockchip display outputs.
# CONFIG_ROCKCHIP_ANALOGIX_DP is not set
# CONFIG_ROCKCHIP_CDN_DP is not set
# CONFIG_ROCKCHIP_DW_DP is not set
# CONFIG_ROCKCHIP_DRM_TVE is not set
# CONFIG_ROCKCHIP_LVDS is not set
# CONFIG_ROCKCHIP_RGB is not set
# CONFIG_ROCKCHIP_DP_MST_AUX_CLIENT is not set

# Production trim of heavy debug/trace/test options. Keep serial console/FIQ
# and debugfs: Buildroot systemd mounts /sys/kernel/debug during local-fs.
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FUNCTION_GRAPH_TRACER is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_RCU_TRACE is not set
# CONFIG_MMC_TEST is not set
# CONFIG_MALI_DEBUG is not set
# CONFIG_MALI_FENCE_DEBUG is not set
# CONFIG_MALI_BIFROST_DEBUG is not set
# CONFIG_MALI_BIFROST_FENCE_DEBUG is not set
# CONFIG_MALI_BIFROST_SYSTEM_TRACE is not set
# CONFIG_MALI_BIFROST_ENABLE_TRACE is not set
# CONFIG_MALI_TRACE_POWER_GPU_WORK_PERIOD is not set
# CONFIG_ROCKCHIP_DRM_DEBUG is not set
# CONFIG_ROCKCHIP_RGA_DEBUG_FS is not set
# CONFIG_ROCKCHIP_RGA_DEBUGGER is not set
# CONFIG_ROCKCHIP_RKNPU_DEBUG_FS is not set

# --- 4.4 attack-surface (post-LTS): unused network filesystems ---
# Appliance does not mount NFS; host cache docs use NFS on the *developer*
# machine only. Keep 9P/virtio for P3.2 emulator (re-enabled later by
# emulator-virtio.config in RK_KERNEL_CFG_FRAGMENTS).
# CONFIG_NFS_FS is not set
# CONFIG_NFS_V2 is not set
# CONFIG_NFS_V3 is not set
# CONFIG_NFS_V3_ACL is not set
# CONFIG_NFS_V4 is not set
# CONFIG_NFS_SWAP is not set
# CONFIG_NFS_V4_1 is not set
# CONFIG_NFS_V4_2 is not set
# CONFIG_NFS_USE_KERNEL_DNS is not set
# CONFIG_PNFS_FILE_LAYOUT is not set
# CONFIG_PNFS_FLEXFILE_LAYOUT is not set
# CONFIG_PNFS_BLOCK is not set
# CONFIG_NFS_FSCACHE is not set
# CONFIG_NFSD is not set
# CONFIG_LOCKD is not set
# CONFIG_LOCKD_V4 is not set
# CONFIG_NFS_ACL_SUPPORT is not set
# CONFIG_NFS_COMMON is not set
# CONFIG_SUNRPC is not set
# CONFIG_SUNRPC_GSS is not set
# CONFIG_SUNRPC_SWAP is not set
# CONFIG_RPCSEC_GSS_KRB5 is not set
