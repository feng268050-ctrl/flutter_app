<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 圆角半径（可根据需求调整，比如8dp） -->
    <corners android:radius="12dp" />

    <!-- 可选：添加边框（宽度1dp，灰色） -->
    <stroke
        android:width="0.5dp"
        android:color="#131535" />

    <!-- 可选：内边距（避免内容贴边） -->
    <padding
        android:left="7dp" />
</shape>