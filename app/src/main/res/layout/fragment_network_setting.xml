<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="networkSetting"
            type="com.lasercyber.lws.ui.bean.entity.NetworkSetting" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".activitys.setting.fragment.NetworkSettingFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="24dp"
            android:layout_marginLeft="24dp"
            android:orientation="vertical">

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:orientation="horizontal">

            <LinearLayout
                android:layout_width="604dp"
                android:layout_height="80dp"
                android:background="@mipmap/net_work_border1"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:paddingTop="22dp"
                android:visibility="gone"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="35sp"
                    android:text="@string/cellular_network_text"
                    android:textColor="@android:color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="35sp"
                    android:gravity="end"
                    android:text="@{networkSetting.network4G?@string/connected_text:@string/not_connecting_text}"
                    android:textColor="@color/tab_text_unselected" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/networkBorder"
                android:layout_width="604dp"
                android:layout_height="80dp"
                android:background="@mipmap/net_work_border2"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:paddingTop="22dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="35sp"
                    android:text="@string/wifi_network_text"
                    android:textColor="@android:color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="35sp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@{(networkSetting.networkWIFI &amp;&amp; networkSetting.wifiName!=null)?networkSetting.wifiName:@string/not_connecting_text}"
                    android:textColor="@color/tab_text_unselected" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:textSize="35sp"
                        android:gravity="end"
                        android:text=">"
                        android:textColor="@color/white" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="604dp"
                android:layout_height="80dp"
                android:layout_marginTop="24dp"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:paddingTop="22dp"
                android:background="@mipmap/net_work_border2"
                android:visibility="gone"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bluetooth_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="35sp"
                    android:text="@string/bluetooth_text"
                    android:textColor="@android:color/white"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end">

                    <com.lasercyber.lws.frostui.control.interop.FrostSwitchView
                        android:id="@+id/bluetooth_switch"
                        style="@style/FrostSwitch"
                        android:enabled="false"
                        android:checked="@{networkSetting.bluetooth}" />

                </LinearLayout>

            </LinearLayout>


            </GridLayout>

        </LinearLayout>

    </FrameLayout>
</layout>