# lws-hmi build tuning (Phase 1): package-internal parallelism.
# BR2_JLEVEL: per-package make -j (match BUILD_JOBS in .env; use 4 if Docker OOM).
#
# Note: BR2_CCACHE is intentionally off — Rockchip Buildroot hits
# HOST_CCACHE_FINAL_RECURSIVE_DEPENDENCIES recursion (ccache.mk:64).

BR2_JLEVEL=8

# Chip fragment rk3566_rk3568.config sets HOSTNAME/ISSUE to rk3566_rk3568.
# Shared product Image is not one SoC forever (P3.2 QEMU / future boards) —
# override after that include (this file is later in the defconfig #include list).
# Runtime hostname(1) alone does not stick: Buildroot bakes /etc/hostname at image build.
BR2_TARGET_GENERIC_HOSTNAME="buildroot"
BR2_TARGET_GENERIC_ISSUE="Welcome to Buildroot"
