From: lws-hmi <lws-hmi@local>
Subject: [PATCH] drm/gem: recover corrupted Rockchip object funcs

Repeated flutter-pi teardown can expose a Rockchip BSP memory corruption
where a live GEM object's funcs pointer is either NULL or replaced by a
stale slab pointer.  The generic release callback then branches through
an invalid close address, observed as ASCII data in the program counter.

Let drivers with one GEM object type publish a canonical funcs table.
Repair Rockchip objects from that immutable table before release or free,
and tolerate a transient NULL/invalid object or corrupted obj->dev pointer
during handle deletion.

--- a/include/drm/drm_drv.h
+++ b/include/drm/drm_drv.h
@@ -34,6 +34,7 @@
 
 struct drm_file;
 struct drm_gem_object;
+struct drm_gem_object_funcs;
 struct drm_master;
 struct drm_minor;
 struct dma_buf;
@@ -298,6 +299,15 @@ struct drm_driver {
 	struct drm_gem_object *(*gem_create_object)(struct drm_device *dev,
 						    size_t size);
 
+	/**
+	 * @gem_object_funcs:
+	 *
+	 * Optional canonical GEM object functions for drivers whose objects all
+	 * share one immutable function table. The GEM core uses this to recover
+	 * an object whose funcs pointer was corrupted during driver teardown.
+	 */
+	const struct drm_gem_object_funcs *gem_object_funcs;
+
 	/**
 	 * @prime_handle_to_fd:
 	 *
--- a/drivers/gpu/drm/drm_gem.c
+++ b/drivers/gpu/drm/drm_gem.c
@@ -228,18 +228,56 @@ drm_gem_object_handle_put_unlocked(struct drm_gem_object *obj)
 		drm_gem_object_put(obj);
 }
 
+static bool drm_gem_object_has_valid_device(struct drm_gem_object *obj)
+{
+	struct drm_device *dev;
+
+	if (!obj || (unsigned long)obj < PAGE_OFFSET || !virt_addr_valid(obj))
+		return false;
+
+	dev = READ_ONCE(obj->dev);
+	if (!dev || (unsigned long)dev < PAGE_OFFSET || !virt_addr_valid(dev))
+		return false;
+
+	return true;
+}
+
+static const struct drm_gem_object_funcs *
+drm_gem_object_get_funcs(struct drm_gem_object *obj)
+{
+	const struct drm_gem_object_funcs *expected;
+
+	expected = obj->dev->driver->gem_object_funcs;
+	if (expected && unlikely(READ_ONCE(obj->funcs) != expected)) {
+		pr_warn_ratelimited("drm: repairing corrupted GEM funcs for %s object %pK (%pK -> %pK)\n",
+				    obj->dev->driver->name, obj,
+				    READ_ONCE(obj->funcs), expected);
+		WRITE_ONCE(obj->funcs, expected);
+	}
+
+	return READ_ONCE(obj->funcs);
+}
+
 /*
  * Called at device or object close to release the file's
  * handle references on objects.
  */
 static int
 drm_gem_object_release_handle(int id, void *ptr, void *data)
 {
+	const struct drm_gem_object_funcs *funcs;
 	struct drm_file *file_priv = data;
 	struct drm_gem_object *obj = ptr;
 
-	if (obj->funcs->close)
-		obj->funcs->close(obj, file_priv);
+	if (!drm_gem_object_has_valid_device(obj)) {
+		pr_warn_ratelimited("drm: ignoring invalid GEM handle object/device %px\n",
+				    obj);
+		return 0;
+	}
+
+	funcs = drm_gem_object_get_funcs(obj);
+	if (funcs && funcs->close)
+		funcs->close(obj, file_priv);
 
 	drm_prime_remove_buf_handle(&file_priv->prime, id);
 	drm_vma_node_revoke(&obj->vma_node, file_priv);
@@ -955,13 +990,18 @@ EXPORT_SYMBOL(drm_gem_object_release);
 void
 drm_gem_object_free(struct kref *kref)
 {
+	const struct drm_gem_object_funcs *funcs;
 	struct drm_gem_object *obj =
 		container_of(kref, struct drm_gem_object, refcount);
 
+	if (WARN_ON(!drm_gem_object_has_valid_device(obj)))
+		return;
+
-	if (WARN_ON(!obj->funcs->free))
+	funcs = drm_gem_object_get_funcs(obj);
+	if (WARN_ON(!funcs || !funcs->free))
 		return;
 
-	obj->funcs->free(obj);
+	funcs->free(obj);
 }
 EXPORT_SYMBOL(drm_gem_object_free);
 
--- a/drivers/gpu/drm/rockchip/rockchip_drm_drv.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_drv.c
@@ -2298,6 +2298,7 @@ static struct drm_driver rockchip_drm_driver = {
 	.postclose		= rockchip_drm_postclose,
 	.lastclose		= rockchip_drm_lastclose,
 	.open			= rockchip_drm_open,
+	.gem_object_funcs	= &rockchip_gem_object_funcs,
 	.dumb_create		= rockchip_gem_dumb_create,
 	.prime_handle_to_fd	= drm_gem_prime_handle_to_fd,
 	.prime_fd_to_handle	= drm_gem_prime_fd_to_handle,
