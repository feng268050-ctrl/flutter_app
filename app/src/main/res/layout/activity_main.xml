                android:textColor="#FFF"
                android:textSize="25sp"/>
        </LinearLayout>-->

        <ImageView
            android:id="@+id/home_remote_lock_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="8dp"
            android:src="@mipmap/wifi_lock_icon"
            android:visibility="gone"
            app:layout_constraintRight_toLeftOf="@id/home_wifi_status_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/home_recording_indicator"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="8dp"
            android:src="@mipmap/camera_stop_icon"
            android:contentDescription="@string/recording_in_progress"
            android:visibility="gone"
            app:layout_constraintRight_toLeftOf="@id/home_remote_lock_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/home_wifi_status_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="20dp"
            android:src="@mipmap/wifi_off"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 顶部居中时钟：须在 FrostCaptureTarget 外采样背景模糊 -->
        <FrameLayout
            android:layout_width="400dp"
            android:layout_height="300dp"
            android:layout_marginLeft="440dp"
            android:layout_marginTop="12dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.lasercyber.lws.frostui.clock.interop.FrostHomeClockView
                android:id="@+id/home_real_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="10dp"
                android:textSize="155sp" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>