// lws-hmi: rootfs on Buildroot GPT (parameter-buildroot-fit.txt).
// rootfs is the 6th GPT entry (after uboot/misc/boot/recovery/backup) → mmcblk0p6.
// PARTUUID from parameter.txt is often not written to eMMC by upgrade_tool.
&chosen {
	bootargs = "earlycon=uart8250,mmio32,0xfe660000 console=ttyFIQ0 root=/dev/mmcblk0p6 rw rootfstype=ext4 rootwait loglevel=4";
};
