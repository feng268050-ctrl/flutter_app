# P2–P5 platform libraries — P1 prep (app/features still phased).

# P2 — Modbus RTU (/dev/ttyS5)
BR2_PACKAGE_LIBMODBUS=y

# Rockchip Vendor Storage userspace (`/usr/bin/vendor_storage`) for product identity.
BR2_PACKAGE_RKTOOLKIT=y

# P4.8 — OTA archive Ed25519 verify (openssl dgst -sha512 -verify)
BR2_PACKAGE_LIBOPENSSL=y
BR2_PACKAGE_LIBOPENSSL_BIN=y

# Entropy daemon for early CRNG (Lynis HW RNG / SW prng). Default BR option
# enables jitterentropy-library (CPU timing); no NIST/Qrypt network beacons.
BR2_PACKAGE_RNG_TOOLS=y
BR2_PACKAGE_RNG_TOOLS_JITTERENTROPY_LIBRARY=y

# P3 — libai.so reads config.yaml
BR2_PACKAGE_YAML_CPP=y

# P5 — local DB + mDNS
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_SQLITE_ENABLE_JSON1=y
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
