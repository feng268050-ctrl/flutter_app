# Large prebuilt artifacts (2GB+, 15k+ files) — tracked in git but not for IDE indexing
prebuilt/

# SDK symlink target (Rockchip tree; tens of GB)
sdk/

# Host Flutter SDK at repo root (gitignored; make fetch-flutter-sdk)
flutter-sdk/
linux-sdk/

# Build outputs and download caches
output/
.cache/

# Generated Flutter release bundles (make build-app)
app/*/build/bundle/release/
app/*/build/bundle/.assemble/

# Local tooling venv
.venv-tools/
