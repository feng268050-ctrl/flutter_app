# Processed by systemd preset-all during rootfs image build (after 80-buildroot.preset).
# Keep sshd installable on demand; do not auto-start at boot (Plan A §3.6).
# MediaMTX is App-owned (no mediamtx.service).
# emulator-sshd / emulator-wlan0-dhcp / lws-hostname: QEMU only (Condition).
disable lws-hmi-debug-boot.service
disable sshd.service
disable sshd.socket
disable ssh-debug-lan.service
disable wlan-wpa.service
disable wlan-dhcp.service
disable eth0-network.service
disable bluetooth.service
disable wifibt-init.service
disable wpa_supplicant.service
disable network.service
disable log-guardian.service
enable systemd-networkd.service
enable systemd-resolved.service
enable systemd-timesyncd.service
enable rtc-systohc.timer
enable oem-compose.service
enable hmi.service
enable pwrkey-poweroff.service
enable ab-boot-confirm.service
enable tee-supplicant.service
enable lws-hostname.service
enable emulator-sshd.service
enable emulator-wlan0-dhcp.service
