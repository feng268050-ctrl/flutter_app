From: lws-hmi <dev@lws>
Date: Wed, 15 Jul 2026 20:00:00 +0800
Subject: [PATCH] user_input: sync lock LEDs with xkb NumLock/CapsLock

Hardware NumLock LED state at plug/boot is independent of a fresh
xkb_state (Mod2 off). Users see inverted keypad behavior: LED on but
Home/End, LED off but digits. Clear LEDs when a keyboard appears so
they match xkb defaults, then drive LEDs from xkb after each key.

diff --git a/src/user_input.c b/src/user_input.c
index 652d7df..203d3e4 100644
--- a/src/user_input.c
+++ b/src/user_input.c
@@ -601,6 +601,10 @@ static int on_device_added(struct user_input *input, struct libinput_event *even
             // If we don't have a keyboard config
             data->keyboard_state = NULL;
         }
+        // Match fresh xkb_state (locks clear).
+        if (data->keyboard_state != NULL) {
+            libinput_device_led_update(device, 0);
+        }
     }
 
     if (libinput_device_has_capability(device, LIBINPUT_DEVICE_CAP_TABLET_TOOL)) {
@@ -721,6 +725,21 @@ static int on_key_event(struct user_input *input, struct libinput_event *event)
         return ok;
     }
 
+    // Keep lock LEDs aligned with xkb (kernel does not infer NumLock for us).
+    {
+        enum libinput_led leds = 0;
+        if (keyboard_state_is_numlock_active(data->keyboard_state)) {
+            leds |= LIBINPUT_LED_NUM_LOCK;
+        }
+        if (keyboard_state_is_capslock_active(data->keyboard_state)) {
+            leds |= LIBINPUT_LED_CAPS_LOCK;
+        }
+        if (keyboard_state_is_scrolllock_active(data->keyboard_state)) {
+            leds |= LIBINPUT_LED_SCROLL_LOCK;
+        }
+        libinput_device_led_update(device, leds);
+    }
+
     // GTK keyevent needs the plain codepoint for some reason.
     /// TODO: Maybe remove the evdev_value parameter?
     plain_codepoint = keyboard_state_get_plain_codepoint(data->keyboard_state, evdev_keycode, 1);
