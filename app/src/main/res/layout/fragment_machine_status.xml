<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="deviceStatus"
            type="com.lasercyber.lws.ui.bean.entity.DeviceStatus" />
        <variable
            name="deviceData"
            type="com.lasercyber.lws.ui.bean.entity.DeviceData" />
        <variable
            name="cameraCommFault"
            type="boolean" />
        <import type="android.view.View" />

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".activitys.device.monitor.fragment.MachineStatusFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/frost_dialog_content_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.lasercyber.lws.ui.component.machine.MachineStatusGaugeCard
                    android:id="@+id/leftGaugeCard"
                    style="@style/MachineStatusGaugeCardMonitor"
                    app:machineStatusVariant="monitor"
                    app:borderGradientCenter="bottom-left-top-right">

                    <com.lasercyber.lws.ui.common.view.CircleProgressView
                        android:id="@+id/leftCircleView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:circle_scale_text_margin="15dp"
                        app:circle_side_length="328dp"
                        app:value_text_offset_x="@dimen/machine_status_gauge_value_offset_x" />
                </com.lasercyber.lws.ui.component.machine.MachineStatusGaugeCard>

                <com.lasercyber.lws.ui.component.machine.MachineStatusGaugeCard
                    style="@style/MachineStatusGaugeCardMonitor"
                    android:layout_marginStart="@dimen/frost_dialog_content_padding"
                    app:machineStatusVariant="monitor"
                    app:borderGradientCenter="top-left-bottom-right">

                    <com.lasercyber.lws.ui.common.view.CircleProgressView
                        android:id="@+id/rightCircleView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:circle_scale_text_margin="15dp"
                        app:circle_side_length="328dp"
                        app:value_text_offset_x="@dimen/machine_status_gauge_value_offset_x" />
                </com.lasercyber.lws.ui.component.machine.MachineStatusGaugeCard>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/frost_dialog_content_padding"
                android:columnCount="4">

                <com.lasercyber.lws.ui.component.machine.MachineStatusStatusTile
                    style="@style/MachineStatusStatusTileMonitor"
                    app:machineStatusVariant="monitor"
                    app:labelText="@string/laser_text"
                    app:machineStatusChecked="@{deviceStatus.isLaserOn}"
                    app:borderGradientCenter="top-left-bottom-right" />

                <com.lasercyber.lws.ui.component.machine.MachineStatusStatusTile
                    style="@style/MachineStatusStatusTileMonitor"
                    android:layout_marginStart="@dimen/frost_dialog_content_padding"
                    app:machineStatusVariant="monitor"
                    app:labelText="@string/blow_text"
                    app:machineStatusChecked="@{deviceStatus.isAirValveOn}"
                    app:borderGradientCenter="top-left-bottom-right" />

                <com.lasercyber.lws.ui.component.machine.MachineStatusStatusTile
                    style="@style/MachineStatusStatusTileMonitor"
                    android:layout_marginStart="@dimen/frost_dialog_content_padding"
                    app:machineStatusVariant="monitor"
                    app:labelText="@string/safety_lock_text"
                    app:machineStatusChecked="@{deviceStatus.isSafetyGroundLockLocked}"
                    app:borderGradientCenter="top-left-bottom-right" />

                <com.lasercyber.lws.ui.component.machine.MachineStatusStatusTile
                    style="@style/MachineStatusStatusTileMonitor"
                    android:layout_marginStart="@dimen/frost_dialog_content_padding"
                    app:machineStatusVariant="monitor"
                    app:labelText="@string/gun_head_switch_text"
                    app:machineStatusChecked="@{deviceStatus.isGunSwitchOn}"
                    app:borderGradientCenter="top-left-bottom-right" />

                <com.lasercyber.lws.ui.component.machine.MachineStatusStatusTile
                    style="@style/MachineStatusStatusTileMonitor"
                    android:layout_marginTop="@dimen/frost_dialog_content_padding"
                    app:machineStatusVariant="monitor"
                    app:labelText="@string/red_light_text"
                    app:machineStatusChecked="@{deviceStatus.isRedLightOn}"
                    app:borderGradientCenter="top-left-bottom-right" />

                <com.lasercyber.lws.ui.component.machine.MachineStatusStatusTile
                    style="@style/MachineStatusStatusTileMonitor"
                    android:layout_marginStart="@dimen/frost_dialog_content_padding"
                    android:layout_marginTop="@dimen/frost_dialog_content_padding"
                    app:machineStatusVariant="monitor"
                    app:labelText="@string/wire_feeding_text"
                    app:machineStatusChecked="@{deviceStatus.isWireFeedingOn}"
                    app:borderGradientCenter="top-left-bottom-right" />

                <com.lasercyber.lws.ui.component.machine.MachineStatusStatusTile
                    style="@style/MachineStatusStatusTileMonitor"
                    android:layout_marginStart="@dimen/frost_dialog_content_padding"
                    android:layout_marginTop="@dimen/frost_dialog_content_padding"
                    app:machineStatusVariant="monitor"
                    app:labelText="@string/camera_title"
                    app:machineStatusChecked="@{!cameraCommFault}"
                    app:borderGradientCenter="top-left-bottom-right" />
            </GridLayout>

        </LinearLayout>

    </FrameLayout>
</layout>
