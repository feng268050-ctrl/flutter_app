# Instance override — stock serial-getty@.service BindsTo=dev-%i.device is evaluated
# before Condition*, stalling boot when the console node is absent (ynh960).
[Unit]
Description=Serial Getty on ttyAMA0
Documentation=man:agetty(8) man:systemd-getty-generator(8)
Documentation=https://0pointer.de/blog/projects/serial-console.html
ConditionPathExists=/dev/ttyAMA0
After=systemd-user-sessions.service plymouth-quit-wait.service getty-pre.target
Before=getty.target
IgnoreOnIsolate=yes
Conflicts=rescue.service
Before=rescue.service

[Service]
ExecStart=-/sbin/agetty -o '-p -- \\u' --keep-baud 115200,57600,38400,9600 - $TERM
Type=idle
Restart=always
UtmpIdentifier=ttyAMA0
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/ttyAMA0
TTYReset=yes
TTYVHangup=yes
KillMode=process
IgnoreSIGPIPE=no
SendSIGHUP=yes
ImportCredential=agetty.*
ImportCredential=login.*

[Install]
WantedBy=getty.target
