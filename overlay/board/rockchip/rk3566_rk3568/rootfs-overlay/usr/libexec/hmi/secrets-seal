#!/bin/sh
# OP-TEE Secrets seal helper — invoked by cyber_hal OpteeKekProvider.
# Usage:
#   secrets-seal probe
#   secrets-seal seal   < JSON {plaintext_b64,aad_b64} on stdin; blob_b64 on stdout
#   secrets-seal unseal < JSON {blob_b64,aad_b64} on stdin; plaintext_b64 on stdout
#
# v1: probe checks TEE devices + optional native CA. Seal TA matched to vendor
# BL32 is not yet shipped — seal/unseal fail closed (exit 75) until native CA+TA
# lands (see openspec/changes/hal-secrets-kek-provider/notes.md).
set -eu

NATIVE_CA="${LWS_SECRETS_SEAL_CA:-/usr/libexec/hmi/secrets-seal-ca}"

die() {
	echo "secrets-seal: $*" >&2
	exit 1
}

cmd_probe() {
	if [ ! -c /dev/tee0 ] && [ ! -c /dev/teepriv0 ]; then
		die "no /dev/tee0 or /dev/teepriv0 (DT optee node + kernel required)"
	fi
	if [ -x "$NATIVE_CA" ]; then
		"$NATIVE_CA" probe || die "native CA probe failed"
	fi
	# TEE device present; seal TA may still be absent (fail on seal).
	exit 0
}

cmd_seal() {
	if [ -x "$NATIVE_CA" ]; then
		exec "$NATIVE_CA" seal
	fi
	echo "secrets-seal: seal TA/CA not provisioned (fail-closed; not software KEK)" >&2
	exit 75
}

cmd_unseal() {
	if [ -x "$NATIVE_CA" ]; then
		exec "$NATIVE_CA" unseal
	fi
	echo "secrets-seal: seal TA/CA not provisioned (fail-closed; not software KEK)" >&2
	exit 75
}

case "${1:-}" in
probe) cmd_probe ;;
seal) cmd_seal ;;
unseal) cmd_unseal ;;
*)
	echo "usage: secrets-seal {probe|seal|unseal}" >&2
	exit 2
	;;
esac
