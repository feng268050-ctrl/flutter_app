# ynh960 onboard combo: AIC8800D80 (SDIO vendor 0xc8a1).
# Firmware lives under /vendor/etc/firmware (Innohi via post-wifibt).
# Modules land in /vendor/lib/modules via post-wifibt `find kernel -name '*.ko'`.

CONFIG_AIC_WLAN_SUPPORT=y
CONFIG_AIC_FW_PATH="/vendor/etc/firmware"
CONFIG_AIC8800_WLAN_SUPPORT=m
CONFIG_AIC8800_BTLPM_SUPPORT=m
