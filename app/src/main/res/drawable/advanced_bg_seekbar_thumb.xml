<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- 滑块大小（宽高一致为圆形，不一致为椭圆） -->
    <size
        android:width="16dp"
        android:height="16dp"/> <!-- 滑块大小：16dp × 16dp -->
    <!-- 滑块颜色 -->
    <solid android:color="@android:color/white"/>
    <!-- 滑块边框（可选） -->
    <stroke
        android:width="1dp"
        android:color="#666666"/>
</shape>