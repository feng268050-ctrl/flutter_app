# Local outputs / caches (repo-root firmware/artifacts only)
# Includes output/cloud/credentials.json from make login (never commit tokens).
/output/
.cache/
__pycache__/
overlay/buildroot/.generated/

# Local firmware images (e.g. Android update.img for make flash-android)
images/

# Host SDKs (real dirs at repo root)
flutter-sdk/
linux-sdk/
.linux-sdk.extracting.*/
.host-deps/

# adb pull backups (regenerate with make pull-display-params)
board/from-device/

# U-Boot boot logo (generated from board/logo/splash_icon.png)
board/logo/logo.bmp
board/logo/logo_kernel.bmp

# Flutter release bundle (run make build-app)
overlay/board/rockchip/rk3566_rk3568/rootfs-overlay/opt/hmi/

# Local env (see .env.example)
.env

# OTA signing private keys (pubkey lives in overlay /etc/ota/)
/keys/ota/*.pem
/keys/ota/ed25519.pem

# Team SSH host private key (pubkey → overlay root/.ssh/authorized_keys)
/keys/ssh/id_ed25519
/keys/ssh/id_rsa

# OP-TEE TA signing private key (BL32-matched vendor key; never commit)
/keys/oem/*.pem
/keys/oem/vendor_ta.pem

# Editor / IDE
.DS_Store
.idea/
*.iml

# Local Python venv for logo / tooling scripts
.venv-tools/
.cursor/*.log
# OEM build outputs (make build-oem)
/oem/out/
prebuilt/emulator-swgl/
