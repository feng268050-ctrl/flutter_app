# ynh960: enable SELinux LSM (permissive userspace via Buildroot refpolicy).
# Vendor rockchip_linux_defconfig ships SECURITY=n / AUDIT=n / LSM without selinux.
# SECURITY_SELINUX depends on SECURITY_NETWORK && AUDIT && NET && INET.
# Do not set CONFIG_SECURITY_SELINUX_DISABLE (runtime disable is deprecated).

CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
# CONFIG_SECURITY_SELINUX_DISABLE is not set
# CONFIG_DEFAULT_SECURITY_DAC is not set
CONFIG_DEFAULT_SECURITY_SELINUX=y
# Keep Rockchip baseline LSMs; append selinux before bpf.
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,selinux,bpf"
# EXT4 security xattrs are already enabled in rockchip_linux_defconfig;
# keep them explicit so trim fragments cannot drop labeling support.
CONFIG_EXT4_FS_XATTR=y
CONFIG_EXT4_FS_SECURITY=y
