From: lws-hmi kernel overlay
Subject: 0009-mali-midgard-use-kernel-minmax-min-max.patch

diff -ruN a/drivers/gpu/arm/midgard/mali_malisw.h b/drivers/gpu/arm/midgard/mali_malisw.h
--- a/drivers/gpu/arm/midgard/mali_malisw.h
+++ b/drivers/gpu/arm/midgard/mali_malisw.h
@@ -47,7 +47,10 @@
  * As a macro it may evaluate its arguments more than once.
  * Refer to MAX macro for more details
  */
-#define MIN(x, y)	((x) < (y) ? (x) : (y))
+/* Keep ternary MIN/MAX: kernel min()/max() typecheck mixed-width Mali calls (-Werror). */
+#ifndef MIN
+#define MIN(x, y)	((x) < (y) ? (x) : (y))
+#endif
 
 /**
  * MAX -  Return the greater of two values.
@@ -59,7 +62,9 @@
  * to retrieve the min and max of two values, consider using a conditional swap
  * instead.
  */
-#define MAX(x, y)	((x) < (y) ? (y) : (x))
+#ifndef MAX
+#define MAX(x, y)	((x) < (y) ? (y) : (x))
+#endif
 
 /**
  * @hideinitializer
