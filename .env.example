# Copy to .env and adjust (do not commit .env).
# Full make target / env var catalog: docs/make-commands.md

# Rockchip Linux SDK is fixed at repo-root linux-sdk/ (gitignored).

# Host Flutter SDK path for build-app / debug / l10n (default: flutter-sdk).
# Install/refetch with: make fetch-flutter-sdk  (override install dir: DEST=…, not FLUTTER_SDK)
# FLUTTER_SDK=flutter-sdk

# USB flash / device selection (see make devices)
# SN=0123456789abcdef
# CHIP_ID=0123456789abcdef   # optional: ChipID-only device selection (multi-board)
# SERIAL=…                  # deprecated alias for SN=
# Remote SSH only (after make connect <ip>; does not select USB-SSH):
# IP=192.168.1.50

# P1.5 debug uses the same SN / IP / FLUTTER_SDK / SSH variables as push-app.

# Optional firmware path override for make flash (default: output/firmware/update.img)
# IMAGE=/path/to/update.img

# Factory variant (daily: only FACTORY_SKU; see docs/make-commands.md common env vars)
# FACTORY_SKU=ynh960-p800
# UBOOT_ID=rockchip-ynh960
# OEM_ID=ynh960_panel-800x1280

# make upgrade — OEM partition / prebuilt package (see scripts/upgrade-remote.sh)
# OEM_ONLY=1                 # oem.img only (plain reboot; no A/B switch); required for oem-only UPGRADE_PACKAGE
# OEM_IMG=/path/to/oem.img   # override resolved oem.img; OEM_IMG= empty skips oem on full upgrade
# UPGRADE_PACKAGE=/path/to/ota-package.tar.gz  # skip pack-ota rebuild; SSH needs sibling .sig; RockUSB extracts+di
# UPGRADE_TRANSPORT=auto     # auto|ssh|rockusb

# Cloud api-server (make login / register-device / publish) — sibling ../api-server Worker
# Default: production. Override for test:
# CLOUD_API_BASE=https://api-test.lasercyber.workers.dev
# CLOUD_API_BASE=https://api-prod.lasercyber.workers.dev
# CLOUD_ACCESS_TOKEN=        # optional override; else make login → output/cloud/credentials.json
# CLOUD_ACCOUNT=             # non-interactive make login only (prefer interactive prompt)
# CLOUD_PASSWORD=            # NEVER commit; prefer interactive make login
# PUBLISH_API_TOKEN=         # make publish R2 presign Bearer (STATIC_API_TOKENS); else login token fallback
# PUBLISH_ARTIFACT=lws-hmi   # optional R2 prefix override (default APP with _→-; always release.json)

# Parallel make jobs (default 8 on macOS Docker and Linux native; lower if OOM)
BUILD_JOBS=8
# BUILD_BIND_MOUNT=1          # macOS only
# DOCKER_VOLUME=lws-hmi-sdk

# Team cache for large downloads (not in git). See docs/cache-mirror.md
# NAS_CACHE_ROOT=/Volumes/nas/lws-hmi-cache
# NAS_READ_ONLY=0             # 1 = never write back to NAS (default 0)
