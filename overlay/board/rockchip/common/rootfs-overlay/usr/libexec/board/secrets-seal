#!/bin/sh
# OP-TEE Secrets seal helper — invoked by cyber_hal OpteeKekProvider.
# Usage:
#   secrets-seal probe
#   secrets-seal seal   < JSON {plaintext_b64,aad_b64} on stdin; blob_b64 on stdout
#   secrets-seal unseal < JSON {blob_b64,aad_b64} on stdin; plaintext_b64 on stdout
#   secrets-seal sync-kek   # VS wrap ↔ REE FS (import if VS present; else export+write)
#
set -eu

NATIVE_CA="${LWS_SECRETS_SEAL_CA:-/usr/libexec/board/secrets-seal-ca}"
READ_WRAP="${LWS_SEAL_KEK_READ:-/usr/libexec/board/read-seal-kek-wrapped.sh}"
WRITE_WRAP="${LWS_SEAL_KEK_WRITE:-/usr/libexec/board/write-seal-kek-wrapped.sh}"

die() {
	echo "secrets-seal: $*" >&2
	exit 1
}

# Restore REE KEK from Vendor Storage wrap when present (flash / userdata wipe).
ensure_kek_from_vs() {
	[ -x "$NATIVE_CA" ] || return 0
	[ -x "$READ_WRAP" ] || return 0
	"$READ_WRAP" --present || return 0
	tmp="$(mktemp)"
	"$READ_WRAP" -o "$tmp" || {
		rm -f "$tmp"
		return 0
	}
	[ -s "$tmp" ] || {
		rm -f "$tmp"
		return 0
	}
	# BusyBox base64 -w0 may be unavailable; strip newlines.
	b64="$(base64 <"$tmp" | tr -d '\n\r ')"
	rm -f "$tmp"
	printf '%s\n' "$b64" | "$NATIVE_CA" kek-import-wrap \
		|| die "kek-import-wrap from Vendor Storage failed"
}

# Persist wrap to VS when missing (after REE has a KEK).
persist_kek_to_vs() {
	[ -x "$NATIVE_CA" ] || return 0
	[ -x "$WRITE_WRAP" ] || return 0
	[ -x "$READ_WRAP" ] || return 0
	if "$READ_WRAP" --present; then
		return 0
	fi
	tmp="$(mktemp)"
	if ! "$NATIVE_CA" kek-export-wrap | base64 -d >"$tmp" 2>/dev/null; then
		# Some base64 use -D
		"$NATIVE_CA" kek-export-wrap | base64 -d >"$tmp" || {
			rm -f "$tmp"
			return 0
		}
	fi
	[ -s "$tmp" ] || {
		rm -f "$tmp"
		return 0
	}
	# First write; ignore "already present" races.
	"$WRITE_WRAP" -i "$tmp" 2>/dev/null || true
	rm -f "$tmp"
}

cmd_probe() {
	if [ ! -c /dev/tee0 ] && [ ! -c /dev/teepriv0 ]; then
		die "no /dev/tee0 or /dev/teepriv0 (DT optee node + kernel required)"
	fi
	if [ -x "$NATIVE_CA" ]; then
		"$NATIVE_CA" probe || die "native CA probe failed"
	fi
	ensure_kek_from_vs
	exit 0
}

cmd_sync_kek() {
	[ -x "$NATIVE_CA" ] || die "native CA missing"
	ensure_kek_from_vs
	persist_kek_to_vs
	echo "secrets-seal: sync-kek OK"
	exit 0
}

cmd_seal() {
	if [ -x "$NATIVE_CA" ]; then
		ensure_kek_from_vs
		# stdin must reach CA; capture then feed.
		input="$(cat)"
		printf '%s' "$input" | "$NATIVE_CA" seal
		persist_kek_to_vs
		exit 0
	fi
	echo "secrets-seal: seal TA/CA not provisioned (fail-closed; not software KEK)" >&2
	exit 75
}

cmd_unseal() {
	if [ -x "$NATIVE_CA" ]; then
		ensure_kek_from_vs
		exec "$NATIVE_CA" unseal
	fi
	echo "secrets-seal: seal TA/CA not provisioned (fail-closed; not software KEK)" >&2
	exit 75
}

case "${1:-}" in
probe) cmd_probe ;;
seal) cmd_seal ;;
unseal) cmd_unseal ;;
sync-kek) cmd_sync_kek ;;
*)
	echo "usage: secrets-seal {probe|seal|unseal|sync-kek}" >&2
	exit 2
	;;
esac
