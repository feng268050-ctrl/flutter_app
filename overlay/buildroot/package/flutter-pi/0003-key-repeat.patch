From: lws-hmi <dev@lws>
Date: Wed, 15 Jul 2026 20:45:00 +0800
Subject: [PATCH] user_input: software key auto-repeat via sd_event timer

libinput does not synthesize key repeats. Arm a monotonic sd_event
timer (660ms delay, 40ms interval) and re-emit utf8/xkb keysyms only.

--- a/src/user_input.h
+++ b/src/user_input.h
@@ -12,6 +12,7 @@
 #define _FLUTTERPI_SRC_USER_INPUT_H
 
 #include <flutter_embedder.h>
+#include <systemd/sd-event.h>
 #include <xkbcommon/xkbcommon.h>
 
 #include "plugins/raw_keyboard.h"
@@ -78,6 +79,7 @@
 struct user_input *user_input_new(
     const struct user_input_interface *interface,
     void *userdata,
+    sd_event *event_loop,
     const struct mat3f *display_to_view_transform,
     const struct mat3f *view_to_display_transform,
     unsigned int display_width,
--- a/src/user_input.c
+++ b/src/user_input.c
@@ -1,5 +1,7 @@
 #include "user_input.h"
 
+#include <ctype.h>
+#include <stdint.h>
 #include <errno.h>
 #include <math.h>
 #include <stdio.h>
@@ -24,6 +26,9 @@
 #define LIBINPUT_VER(major, minor, patch) ((((major) & 0xFF) << 16) | (((minor) & 0xFF) << 8) | ((patch) & 0xFF))
 #define THIS_LIBINPUT_VER LIBINPUT_VER(LIBINPUT_VERSION_MAJOR, LIBINPUT_VERSION_MINOR, LIBINPUT_VERSION_PATCH)
 
+#define KEY_REPEAT_DELAY_USEC (660ULL * 1000ULL)
+#define KEY_REPEAT_INTERVAL_USEC (40ULL * 1000ULL)
+
 struct input_device_data {
     struct keyboard_state *keyboard_state;
     int64_t buttons;
@@ -94,6 +99,15 @@
      * @brief Number of pointer events currently contained in @ref collected_flutter_pointer_events.
      */
     size_t n_collected_flutter_pointer_events;
+
+    sd_event *event_loop;
+    sd_event_source *repeat_timer;
+    bool repeating;
+    uint16_t repeat_evdev_keycode;
+    xkb_keysym_t repeat_keysym;
+    uint8_t repeat_utf8[5];
+    bool has_utf8;
+    bool has_keysym;
 };
 
 static inline FlutterPointerEvent make_touch_event(FlutterPointerPhase phase, size_t timestamp, struct vec2f pos, int32_t device_id) {
@@ -274,10 +288,116 @@
 }
 
 static const struct libinput_interface libinput_interface = { .open_restricted = on_open, .close_restricted = on_close };
+
+static void key_repeat_cancel(struct user_input *input) {
+    assert(input != NULL);
+
+    if (input->repeat_timer != NULL) {
+        sd_event_source_set_enabled(input->repeat_timer, SD_EVENT_OFF);
+    }
+
+    input->repeating = false;
+    input->repeat_evdev_keycode = 0;
+    input->repeat_keysym = 0;
+    memset(input->repeat_utf8, 0, sizeof(input->repeat_utf8));
+    input->has_utf8 = false;
+    input->has_keysym = false;
+}
+
+static int key_repeat_schedule(struct user_input *input, uint64_t delay_usec) {
+    uint64_t now;
+    int ok;
+
+    assert(input != NULL);
+    assert(input->repeat_timer != NULL);
+    assert(input->event_loop != NULL);
+
+    ok = sd_event_now(input->event_loop, CLOCK_MONOTONIC, &now);
+    if (ok < 0) {
+        LOG_ERROR("Could not read monotonic time for key repeat. sd_event_now: %s\n", strerror(-ok));
+        return ok;
+    }
+
+    ok = sd_event_source_set_time(input->repeat_timer, now + delay_usec);
+    if (ok < 0) {
+        LOG_ERROR("Could not arm key repeat timer. sd_event_source_set_time: %s\n", strerror(-ok));
+        return ok;
+    }
 
+    ok = sd_event_source_set_enabled(input->repeat_timer, SD_EVENT_ONESHOT);
+    if (ok < 0) {
+        LOG_ERROR("Could not enable key repeat timer. sd_event_source_set_enabled: %s\n", strerror(-ok));
+        return ok;
+    }
+
+    return 0;
+}
+
+static int on_key_repeat_timer(sd_event_source *s, uint64_t usec, void *userdata) {
+    struct user_input *input;
+    int ok;
+
+    (void) s;
+    (void) usec;
+
+    assert(userdata != NULL);
+    input = userdata;
+
+    if (!input->repeating) {
+        return 0;
+    }
+
+    // Soft repeats only: do not advance xkb/libinput state or emit gtk keyevents.
+    if (input->has_utf8 && input->interface.on_utf8_character != NULL) {
+        input->interface.on_utf8_character(input->userdata, input->repeat_utf8);
+    }
+    if (input->has_keysym && input->interface.on_xkb_keysym != NULL) {
+        input->interface.on_xkb_keysym(input->userdata, input->repeat_keysym);
+    }
+
+    ok = key_repeat_schedule(input, KEY_REPEAT_INTERVAL_USEC);
+    if (ok < 0) {
+        key_repeat_cancel(input);
+    }
+
+    return 0;
+}
+
+static bool key_should_repeat(struct keyboard_state *keyboard_state, uint16_t evdev_keycode, xkb_keysym_t keysym, const uint8_t *utf8) {
+    struct xkb_keymap *keymap;
+
+    assert(keyboard_state != NULL);
+
+    if (keyboard_state->state != NULL) {
+        keymap = xkb_state_get_keymap(keyboard_state->state);
+        if (keymap != NULL) {
+            return xkb_keymap_key_repeats(keymap, (xkb_keycode_t) (evdev_keycode + 8u));
+        }
+    }
+
+    if (utf8 != NULL && utf8[0] != 0) {
+        return true;
+    }
+
+    switch (keysym) {
+        case XKB_KEY_Left:
+        case XKB_KEY_Right:
+        case XKB_KEY_Up:
+        case XKB_KEY_Down:
+        case XKB_KEY_BackSpace:
+        case XKB_KEY_Delete:
+        case XKB_KEY_Home:
+        case XKB_KEY_End: return true;
+        default: break;
+    }
+
+    return false;
+}
+
 struct user_input *user_input_new(
     const struct user_input_interface *interface,
     void *userdata,
+    sd_event *event_loop,
     const struct mat3f *display_to_view_transform,
     const struct mat3f *view_to_display_transform,
     unsigned int display_width,
@@ -338,9 +458,53 @@
     input->cursor_y = 0.0;
 
     input->n_collected_flutter_pointer_events = 0;
+
+    input->event_loop = event_loop;
+    input->repeat_timer = NULL;
+    input->repeating = false;
+    input->repeat_evdev_keycode = 0;
+    input->repeat_keysym = 0;
+    memset(input->repeat_utf8, 0, sizeof(input->repeat_utf8));
+    input->has_utf8 = false;
+    input->has_keysym = false;
+
+    if (event_loop != NULL) {
+        ok = sd_event_add_time(
+            event_loop,
+            &input->repeat_timer,
+            CLOCK_MONOTONIC,
+            UINT64_MAX,
+            0,
+            on_key_repeat_timer,
+            input
+        );
+        if (ok < 0) {
+            LOG_ERROR("Could not create key repeat timer. sd_event_add_time: %s\n", strerror(-ok));
+            goto fail_destroy_kbdcfg;
+        }
+
+        ok = sd_event_source_set_enabled(input->repeat_timer, SD_EVENT_OFF);
+        if (ok < 0) {
+            LOG_ERROR("Could not disable key repeat timer. sd_event_source_set_enabled: %s\n", strerror(-ok));
+            goto fail_unref_repeat_timer;
+        }
+    }
 
     return input;
 
+fail_unref_repeat_timer:
+    sd_event_source_unref(input->repeat_timer);
+    input->repeat_timer = NULL;
+
+fail_destroy_kbdcfg:
+    if (input->kbdcfg != NULL) {
+        keyboard_config_destroy(input->kbdcfg);
+        input->kbdcfg = NULL;
+    }
+    libinput_unref(input->libinput);
+    free(input);
+    return NULL;
+
 fail_unref_libinput:
     libinput_unref(libinput);
     goto fail_free_input;
@@ -387,6 +551,12 @@
         libinput_event_destroy(event);
     }
 
+    key_repeat_cancel(input);
+    if (input->repeat_timer != NULL) {
+        sd_event_source_unref(input->repeat_timer);
+        input->repeat_timer = NULL;
+    }
+
     if (input->kbdcfg != NULL) {
         keyboard_config_destroy(input->kbdcfg);
     }
@@ -420,6 +590,7 @@
 
 void user_input_suspend(struct user_input *input) {
     ASSERT_NOT_NULL(input);
+    key_repeat_cancel(input);
     libinput_suspend(input->libinput);
 }
 
@@ -666,6 +837,7 @@
     }
 
     if (libinput_device_has_capability(device, LIBINPUT_DEVICE_CAP_KEYBOARD)) {
+        key_repeat_cancel(input);
         // create a new keyboard state for this keyboard
         if (data->keyboard_state != NULL) {
             keyboard_state_destroy(data->keyboard_state);
@@ -828,6 +1000,27 @@
         }
     }
 
+    // Software auto-repeat (libinput does not synthesize key repeats).
+    if (key_state == LIBINPUT_KEY_STATE_RELEASED) {
+        if (input->repeating && input->repeat_evdev_keycode == evdev_keycode) {
+            key_repeat_cancel(input);
+        }
+    } else if (key_state == LIBINPUT_KEY_STATE_PRESSED) {
+        key_repeat_cancel(input);
+
+        if (input->repeat_timer != NULL && key_should_repeat(data->keyboard_state, evdev_keycode, keysym, utf8_character)) {
+            input->repeating = true;
+            input->repeat_evdev_keycode = evdev_keycode;
+            input->repeat_keysym = keysym;
+            memcpy(input->repeat_utf8, utf8_character, sizeof(input->repeat_utf8));
+            input->has_utf8 = utf8_character[0] != 0;
+            input->has_keysym = keysym != 0;
+            if (key_repeat_schedule(input, KEY_REPEAT_DELAY_USEC) < 0) {
+                key_repeat_cancel(input);
+            }
+        }
+    }
+
     return 0;
 }
 
--- a/src/flutter-pi.c
+++ b/src/flutter-pi.c
@@ -2590,6 +2590,7 @@
     input = user_input_new(
         &user_input_interface,
         fpi,
+        event_loop,
         &geometry.display_to_view_transform,
         &geometry.view_to_display_transform,
         geometry.display_size.x,
