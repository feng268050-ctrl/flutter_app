# lws-hmi P3.2 Path B — aarch64 virt guest (UTM / QEMU virt).
# Base: upstream-style qemu_aarch64_virt; userspace aligned with device HMI stack.
# Apply via scripts/build-emulator.sh (not Rockchip lunch).

BR2_aarch64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_AS_TOOLCHAIN=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_1=y

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.1.97"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_LWS_HMI_PATH)/board/virt/linux-virt.fragment"

BR2_TARGET_GENERIC_HOSTNAME="lws-hmi-sim"
BR2_TARGET_GENERIC_ISSUE="lws-hmi P3.2 virt"

BR2_ROOTFS_SYSTEMD=y
BR2_INIT_SYSTEMD=y

BR2_PACKAGE_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DESKTOP_SHELL=y
BR2_PACKAGE_OPENSSH=y

# Disk / rootfs for UTM
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"

# Overlay injected by build-emulator.sh via BR2_ROOTFS_OVERLAY
