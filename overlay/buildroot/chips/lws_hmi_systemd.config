# lws-hmi Plan A: systemd as PID 1 (§3.6). BR2_PACKAGE_SYSTEMD also provides libsystemd.so
# (flutter-pi links sd_event; runtime does not require PID 1 == systemd — see plan §3.6).

BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD=y

# Desktop / network daemons not needed on HMI.
# BR2_PACKAGE_SYSTEMD_NETWORKD is not set
# BR2_PACKAGE_SYSTEMD_RESOLVED is not set
# BR2_PACKAGE_SYSTEMD_TIMESYNCD is not set
# BR2_PACKAGE_SYSTEMD_LOGIND is not set
# BR2_PACKAGE_SYSTEMD_POLKIT is not set
# BR2_PACKAGE_SYSTEMD_ANALYZE is not set
# BR2_PACKAGE_SYSTEMD_FIRSTBOOT is not set
# BR2_PACKAGE_SYSTEMD_HOMED is not set
# BR2_PACKAGE_SYSTEMD_HOSTNAMED is not set
# BR2_PACKAGE_SYSTEMD_MACHINED is not set
# BR2_PACKAGE_SYSTEMD_PORTABLED is not set
# BR2_PACKAGE_SYSTEMD_UTMP is not set

# After systemd preset-all in rootfs fakeroot: strip non-critical *.wants (see lws-hmi-post-fakeroot.sh).
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="board/rockchip/rk3566_rk3568/lws-hmi-post-fakeroot.sh"
