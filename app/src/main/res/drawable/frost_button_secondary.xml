<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#28FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/frost_rectangle_button_corner_radius" />
            <gradient
                android:angle="270"
                android:endColor="@color/frost_button_secondary_fill_bottom"
                android:startColor="@color/frost_button_secondary_fill_top"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="@color/frost_button_secondary_stroke" />
        </shape>
    </item>
</ripple>
