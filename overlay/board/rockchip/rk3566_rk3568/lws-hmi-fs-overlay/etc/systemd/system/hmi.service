[Unit]
Description=flutter-pi HMI
DefaultDependencies=yes
After=local-fs.target
# Optional on lws_hmi images: param-update.service / mainserver.service
# sdk-native: panel init is in kernel DTS (panel-init-sequence).
# Do not wait for network or MediaMTX (KPI = first home frame).

[Service]
Type=simple
ExecStart=/usr/bin/flutter-pi --release -o landscape_left /opt/hmi
Restart=on-failure
RestartSec=2
Environment=FLUTTER_PI=1

[Install]
WantedBy=multi-user.target
