[Unit]
Description=Restore hardware settings from subsystem state dirs
Documentation=file:///usr/libexec/hmi/restore-settings.sh
DefaultDependencies=no
# Prefs need userdata (param-update). Network/BT restore MUST run only after HMI
# is up — UI absolute priority (not parallel with flutter-pi first frame).
After=hmi.service param-update.service
Wants=param-update.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Yield CPU/IO so restore never starves the UI while bringing Wi‑Fi/BT up.
Nice=10
CPUWeight=1
IOSchedulingClass=idle
IOSchedulingPriority=7
ExecStartPre=-/usr/libexec/hmi/bind-prefs.sh
# Let first home frame paint before SDIO / bluetooth / dhcpcd load the bus.
ExecStartPre=/bin/sleep 3
ExecStart=/usr/libexec/hmi/restore-settings.sh
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
