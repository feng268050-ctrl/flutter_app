# ynh960: Goodix GT9xx touchscreen (customer_board_ynh960.dtsi goodix_ts@5d).
# Focaltech @0x38 does not ACK on product hardware; do not build FTS.
# rockchip_linux_defconfig already has CONFIG_TOUCHSCREEN_GT9XX=y; keep it
# explicit here so the fragment documents the product touch path.
CONFIG_TOUCHSCREEN_GT9XX=y
# CONFIG_TOUCHSCREEN_FTS is not set
