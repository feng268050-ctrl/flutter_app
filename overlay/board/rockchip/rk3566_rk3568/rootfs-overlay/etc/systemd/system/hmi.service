[Unit]
Description=Flutter HMI
DefaultDependencies=yes
After=local-fs.target cpu-performance.service oem-compose.service
Wants=oem-compose.service
# Optional on lws_hmi images: param-update.service / mainserver.service
# Panel init is in kernel DTS (panel-init-sequence).
# Do not wait for network or MediaMTX (KPI = first home frame).
# Pull settings restore *after* we are up (unit has After=hmi.service).

[Service]
Type=simple
Nice=-5
# Runs as root so /dev/ttyS5 (Modbus), GPIO sysfs, backlight sysfs,
# and ALSA devices remain accessible for P2 / P2.1 demos.
# Weston + flutter-wayland-client (eLinux).
ExecStart=/usr/libexec/hmi/hmi-launch.sh
Restart=on-failure
RestartSec=2
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
