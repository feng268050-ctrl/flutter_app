# P2 Modbus RTU + GPIO demo host libraries for flutter-pi HMI.
# flutter_libserialport / libserialport Dart FFI need libserialport.so on rootfs.
#
# P2.1 speaker smoke: minimal ALSA userland + mpg123 (Dart LinuxMediaAudioController).

BR2_PACKAGE_LIBSERIALPORT=y

# --- P2.1 audio (speaker / volume smoke; not full P5 GStreamer stack) ---
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_MPG123=y
