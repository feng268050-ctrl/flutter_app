From: lws-hmi <dev@lws>
Date: Thu, 16 Jul 2026 23:15:00 +0800
Subject: [PATCH] user_input: pointer_axes auto/normal/swap for REL+ABS motion

BLE HOGP keyboard+trackpad combos may report swapped REL/ABS axes.
Current QM002 / stock BlueZ HOGP on ynh960 reports native axes.

mouse.conf pointer_axes:
  auto   → same as normal (no automatic swap; former BT+kb+pointer heuristic
           inverted correctly-oriented pads like QM002)
  normal → never swap
  swap   → always swap XY on pointer motion (REL and ABS)

Use Swap XY only when a given pad is inverted.
---
--- a/src/user_input.c
+++ b/src/user_input.c
@@ -1330,6 +1330,21 @@
     return 0;
 }
 
+
+/* REL/ABS axis policy from mouse.conf pointer_axes (0=auto, 1=normal, 2=swap). */
+static bool lws_pointer_needs_axis_swap(struct user_input *input, struct libinput_device *device) {
+    (void) device;
+
+    if (input->mouse_pointer_axes == 1) {
+        return false;
+    }
+    if (input->mouse_pointer_axes == 2) {
+        return true;
+    }
+    /* auto (== normal): do not guess — BT+kb+pointer heuristic broke QM002. */
+    return false;
+}
+
 static int on_mouse_motion_event(struct user_input *input, struct libinput_event *event) {
     struct libinput_event_pointer *pointer_event;
     struct input_device_data *data;
@@ -1347,10 +1362,19 @@
 
     data->timestamp = timestamp;
 
-    delta = transform_point(
-        input->view_to_display_transform_nontranslating,
-        VEC2F(libinput_event_pointer_get_dx(pointer_event), libinput_event_pointer_get_dy(pointer_event))
-    );
+    {
+        double dx = libinput_event_pointer_get_dx(pointer_event);
+        double dy = libinput_event_pointer_get_dy(pointer_event);
+        if (lws_pointer_needs_axis_swap(input, device)) {
+            double tmp = dx;
+            dx = dy;
+            dy = tmp;
+        }
+        delta = transform_point(
+            input->view_to_display_transform_nontranslating,
+            VEC2F(dx, dy)
+        );
+    }
 
     pos_display = VEC2F(input->cursor_x + delta.x, input->cursor_y + delta.y);
 
@@ -1412,10 +1436,17 @@
     timestamp = libinput_event_pointer_get_time_usec(pointer_event);
 
     // get the new mouse position in display coordinates
-    pos_display = VEC2F(
-        libinput_event_pointer_get_absolute_x_transformed(pointer_event, input->display_width),
-        libinput_event_pointer_get_absolute_y_transformed(pointer_event, input->display_height)
-    );
+    if (lws_pointer_needs_axis_swap(input, device)) {
+        pos_display = VEC2F(
+            libinput_event_pointer_get_absolute_y_transformed(pointer_event, input->display_width),
+            libinput_event_pointer_get_absolute_x_transformed(pointer_event, input->display_height)
+        );
+    } else {
+        pos_display = VEC2F(
+            libinput_event_pointer_get_absolute_x_transformed(pointer_event, input->display_width),
+            libinput_event_pointer_get_absolute_y_transformed(pointer_event, input->display_height)
+        );
+    }
 
     data->timestamp = timestamp;
 
