# HMI Bluetooth: pairing / management only (P5.2 settings page).
# No A2DP — device is not a BT speaker and does not use BT headphones.
# wifibt/bt.config is included first; this overrides audio-profile packages.

BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
BR2_PACKAGE_RKWIFIBT=y
BR2_PACKAGE_RKWIFIBT_APP=y

# BR2_PACKAGE_BLUEZ_ALSA is not set
# BR2_PACKAGE_BLUEZ_ALSA_HCITOP is not set
