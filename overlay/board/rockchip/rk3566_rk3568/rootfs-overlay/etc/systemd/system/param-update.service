[Unit]
Description=ynh960 MIPI display init (Innohi MountAll/ParamUpdate)
DefaultDependencies=no
After=systemd-remount-fs.service
Before=mainserver.service hmi.service sysinit.target
# Board-only ParamUpdate/MountAll. P3.2 QEMU: oem-compose mounts /dev/vdb; no MIPI.
ConditionKernelCommandLine=!lws.emulator=1

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/display/ynh960-display-init.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
