# Phase 4b: GStreamer/MPP from prebuilt/gstreamer/target overlay (no BR compile).
# Populate: make build-gstreamer  (before make build-rootfs)

BR2_ROOTFS_OVERLAY+="board/rockchip/rk3566_rk3568/lws-hmi-prebuilt-gstreamer/"

# flutter-pi RTSP preview still links against gstreamer libs in the overlay.
BR2_PACKAGE_FLUTTER_PI_GSTREAMER_VIDEO_PLAYER_PLUGIN=y
