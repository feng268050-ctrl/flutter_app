[Unit]
Description=lws-hmi apply Micro-USB USB Debug preference at boot
DefaultDependencies=no
After=sysinit.target systemd-udev-settle.service
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/lib/lws-hmi/usb-otg-mode.sh apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
