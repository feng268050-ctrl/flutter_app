// ek3562 MIPI panel — captured from lab board live FDT (2026-08-15).
// bootargs lcdtype=2 selects the vendor 7" table (7-panel-init-sequence).
// Native timing was timingzero: 800x1280 @ 67 MHz.
// Overrides Rockchip EVB reference 1080x1920 in rk3562-evb.dtsi.
// Not the same panel as ynh960 (same resolution, different init/porch).
#include <dt-bindings/display/drm_mipi_dsi.h>

