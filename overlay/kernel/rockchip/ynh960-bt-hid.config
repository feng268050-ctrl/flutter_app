# Pin Bluetooth HID host support (Classic HIDP + BLE HOG/UHID).
# Verified present as =y on ynh960 baseline; keep explicit so trim fragments cannot drop them.
CONFIG_BT_HIDP=y
CONFIG_UHID=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_EVDEV=y
# Ensure UHID is not left as module-only on some Rockchip bases (prefer built-in).
# If a later fragment sets =m, re-assert =y here (this fragment is last in ynh960_defconfig).
