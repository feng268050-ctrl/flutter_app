<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/frost_dialog_prompt_content_inset"
    android:paddingEnd="@dimen/frost_dialog_prompt_content_inset">

    <ImageView
        android:id="@+id/prompt_icon"
        android:layout_width="@dimen/frost_dialog_prompt_icon_size"
        android:layout_height="@dimen/frost_dialog_prompt_icon_size"
        android:layout_gravity="center_horizontal"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/prompt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/frost_dialog_prompt_content_inset"
        android:layout_marginBottom="@dimen/frost_dialog_prompt_content_inset"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineHeight="@dimen/frost_dialog_prompt_title_text_size"
        android:lineSpacingExtra="0dp"
        android:lineSpacingMultiplier="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:textAlignment="center"
        android:textSize="@dimen/frost_dialog_prompt_title_text_size"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/prompt_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/frost_dialog_prompt_content_inset"
        android:maxHeight="@dimen/frost_dialog_prompt_scroll_max_height"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:overScrollMode="never"
        android:scrollbarSize="10dp"
        android:scrollbarStyle="insideOverlay"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <com.lasercyber.lws.ui.common.view.WarnProgressView
                android:id="@+id/prompt_progress"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/prompt_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:includeFontPadding="false"
                android:lineSpacingExtra="6dp"
                android:textAlignment="viewStart"
                android:textColor="@color/text_black"
                android:textSize="37sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
