# OP-TEE client for HAL Secrets (hardware KEK on product images).
# Spike: BL32 present; need tee-supplicant + libteec after DT optee node.
# RPMB emu OFF — real eMMC has /dev/mmcblk0rpmb.

BR2_PACKAGE_OPTEE_CLIENT=y
# BR2_PACKAGE_OPTEE_CLIENT_RPMB_EMU is not set
BR2_PACKAGE_OPTEE_CLIENT_TEE_FS_PATH="/var/lib/tee"
BR2_PACKAGE_OPTEE_CLIENT_SUPP_PLUGINS=y
# BR2_PACKAGE_OPTEE_CLIENT_TEEACL is not set
