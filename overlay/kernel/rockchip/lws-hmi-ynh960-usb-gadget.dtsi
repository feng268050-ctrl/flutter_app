// lws-hmi ynh960: Micro-USB OTG as USB gadget (ECM) for plug-ssh debug.
//
// Innohi enables usbhost_dwc3 on u2phy0_host for the 1 mm USB host expansion.
// Keep that host path OK (see lws-hmi-ynh960-usb-host.dtsi). OTG uses the
// separate u2phy0_otg + usbdrd_dwc3 in peripheral mode only.

&usb2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
};

&usbdrd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
	phys = <&u2phy0_otg>;
	phy-names = "usb2-phy";
	extcon = <&usb2phy0>;
	maximum-speed = "high-speed";
	snps,dis_u2_susphy_quirk;
};

&usbdrd30 {
	status = "okay";
};
