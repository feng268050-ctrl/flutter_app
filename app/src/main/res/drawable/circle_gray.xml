<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval"> <!-- 椭圆形状（宽高相等时为正圆） -->

    <!-- 填充灰色（常用 #CCCCCC 浅灰，#999999 中灰，可按需调整） -->
    <solid android:color="#CCCCCC" />

    <!-- 可选：添加白色边框（增强区分度） -->
    <stroke
        android:width="1dp"
        android:color="#EEEEEE" />

    <!-- 可选：添加轻微阴影（API 21+，更立体） -->
    <padding
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp" />
    <corners android:radius="6dp" /> <!-- 半径与宽高一半一致 -->
    <!-- <elevation android:elevation="1dp"/> -->
</shape>