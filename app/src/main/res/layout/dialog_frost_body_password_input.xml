<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingRight="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/frost_dialog_text_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dialog_edit_bg"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical|start"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:minHeight="72dp"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="56dp"
            android:paddingBottom="12dp"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:textColor="@color/frost_text_primary"
            android:textSize="33sp" />

        <ImageButton
            android:id="@+id/frost_dialog_text_input_visibility"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/wifi_dialog_show_password"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_password_visibility_off" />
    </FrameLayout>
</LinearLayout>
