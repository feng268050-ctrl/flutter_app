# HMI Bluetooth: discoverable peer + A2DP Sink (phone music → onboard speaker).
# Still no A2DP Source / headset role (we do not connect to BT headphones).
# wifibt/bt.config is included first; this fragment pins product choices.
# Userspace pin: overlay/buildroot/package/bluez5_utils (≥ 5.87).

# System D-Bus required for bluetoothd (org.bluez). Overlay also ships
# etc/dbus-1/system.d/bluetooth.conf in case the BlueZ package omits it.
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
# Required profiles (Config.in no longer defaults these on after 5.86+ recipe).
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HOG=y
# H1: no PBAP/file transfer — leave OBEX off (obexd not built).
# BR2_PACKAGE_BLUEZ5_UTILS_OBEX is not set
BR2_PACKAGE_RKWIFIBT=y
BR2_PACKAGE_RKWIFIBT_APP=y

# A2DP Sink via BlueZ-ALSA (MediaEndpoint + bluealsa-aplay → ALSA speaker).
BR2_PACKAGE_BLUEZ_ALSA=y
# BR2_PACKAGE_BLUEZ_ALSA_HCITOP is not set
