[Unit]
Description=Compose OEM board/screen pack into /run/hmi
DefaultDependencies=no
After=param-update.service local-fs.target
Before=hmi.service mainserver.service
Wants=param-update.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/hmi/oem-compose.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
