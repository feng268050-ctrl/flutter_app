# Kernel fragment: virtio (+ USB serial/BT) so the *same* product-line Image
# can also boot under QEMU (-machine virt) for P3.2 sim OEM.
# This is not a ynh960 board feature — included in the shared Image build only
# so one kernel serves device FIT and emulator. Keep options additive.

CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_MULTITOUCH=y
CONFIG_DRM_VIRTIO_GPU=y
# Platform RNG for sim/virt motherboard (systemd machine-id / getrandom).
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_GPIO_SIM=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_BT=y
CONFIG_BT_HCIBTUSB=y
# Host audio via QEMU virtio-sound (CoreAudio / Pulse / ALSA audiodev).
CONFIG_SND_VIRTIO=y
