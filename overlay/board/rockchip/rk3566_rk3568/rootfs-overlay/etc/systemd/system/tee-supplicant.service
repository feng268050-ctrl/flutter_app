[Unit]
Description=OP-TEE Client Supplicant
Documentation=https://github.com/OP-TEE/optee_client
DefaultDependencies=yes
# After userdata is mounted — interim REE FS KEK lives under /userdata/tee
# (survives A/B). Target end-state is RPMB (see docs/hal-secrets-kek.md).
After=local-fs.target userdata.mount
RequiresMountsFor=/userdata
# Outside HMI cgroup — available before / with Secrets consumers.
Before=hmi.service

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /userdata/tee
# Wrapper: -r <eMMC CID> for when BL32 exposes RPMB; -f /userdata/tee for
# interim REE FS KEK (not on A/B rootfs /var/lib/tee).
ExecStart=/usr/libexec/board/tee-supplicant-start.sh
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
