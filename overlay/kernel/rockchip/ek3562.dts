#include "rk3562-linux.dtsi"
#include "rk3562-rk809.dtsi"
#include "rk3562-evb2-cam.dtsi"
/* PCA9535 OUT0–3 + SoC IN0–3 gpio-line-names; see docs/ek3562-io-pinmux-ledger.md */
#include "ek3562-io.dtsi"
