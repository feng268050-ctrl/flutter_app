# P2–P5 platform libraries — P1 prep (app/features still phased).

# P2 — Modbus RTU (/dev/ttyS5)
BR2_PACKAGE_LIBMODBUS=y

# P3 — libai.so reads config.yaml
BR2_PACKAGE_YAML_CPP=y

# P5 — local DB + mDNS
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_SQLITE_ENABLE_JSON1=y
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
