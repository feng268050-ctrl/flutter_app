# Phase 3: Rockchip prebuilt GCC 10.3 — skip Buildroot gcc/glibc compile.
# Requires clean buildroot output when switching from internal toolchain.

#include "toolchain/arm_10_aarch64.config"
# BR2_TOOLCHAIN_BUILDROOT_GLIBC is not set
# BR2_TOOLCHAIN_BUILDROOT_CXX is not set

# Rockchip arm_10_aarch64.config claims UAPI 4.20 (accurate for the prebuilt
# sysroot). Buildroot 2025.02 systemd-networkd depends on headers ≥ 5.4, which
# would drop networkd from the product image. Override the claimed header
# version so NETWORKD/RESOLVED stay selectable; runtime kernel is 6.1 and the
# previous 2024.02 product already shipped networkd on this same toolchain.
# BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_20 is not set
BR2_TOOLCHAIN_EXTERNAL_HEADERS_5_4=y
