# GStreamer RTSP + Rockchip MPP - trimmed for MediaMTX preview (P5.1).
# Keeps local audio playback (ALSA + common RTSP codecs); drops EVB demo plugins.
# Replaces rockchip multimedia gst video+rtsp config includes.

# Rockchip hardware decode and display
BR2_PACKAGE_ROCKCHIP_MPP=y
BR2_PACKAGE_ROCKCHIP_MPP_ALLOCATOR_DRM=y
BR2_PACKAGE_GSTREAMER1_ROCKCHIP=y
BR2_PACKAGE_ROCKCHIP_RGA=y
# Stock gstreamer1-rockchip.mk also checks PREFER (overlay forces -Drga=enabled).
BR2_PREFER_ROCKCHIP_RGA=y

BR2_PACKAGE_GSTREAMER1=y
BR2_PACKAGE_GSTREAMER1_INSTALL_TOOLS=y
BR2_PACKAGE_GSTREAMER1_PARSE=y
BR2_PACKAGE_GSTREAMER1_PLUGIN_REGISTRY=y
# Keep gst_debug on so plugins resolve _gst_debug_min from core.
BR2_PACKAGE_GSTREAMER1_GST_DEBUG=y
# BR2_PACKAGE_GST1_PLUGINS_BASE_INSTALL_TOOLS is not set

# --- gst-plugins-base (selected) ---
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_APP=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_ALSA=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_TCP=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOCONVERTSCALE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEORATE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VORBIS=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_OGG=y

# --- gst-plugins-good (RTSP + audio parsers) ---
BR2_PACKAGE_GST1_PLUGINS_GOOD=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUDIOPARSERS=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUTODETECT=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_RTP=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_RTPMANAGER=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_RTSP=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_UDP=y
# MP4 remux for HAL RTSP recording (qtmux, mp4mux).
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ISOMP4=y
# Default-y demuxers not required for MediaMTX preview or MP4 remux (H2, H3).
# BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AVI is not set
# BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_WAVPARSE is not set
# BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_MATROSKA is not set
# BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_FLV is not set

# --- gst-plugins-bad (video parse, KMS, SDP + AAC decode) ---
BR2_PACKAGE_GST1_PLUGINS_BAD=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_FAAD=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_KMS=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_SDP=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS=y
# High-risk unused bad plugins stay off (H2).
# BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_WEBRTC is not set
# BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_DTLS is not set
# BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_LIBRFB is not set
# BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_WEBRTCDSP is not set

# BR2_PACKAGE_GST1_PLUGINS_UGLY is not set

# Video texture plugin: baked into flutter-embedded-linux prebuilt
# (libvideo_player_plugin.so). No separate flutter-pi GStreamer package.
