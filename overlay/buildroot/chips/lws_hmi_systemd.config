# lws-hmi Plan A: systemd as PID 1 (§3.6). BR2_PACKAGE_SYSTEMD also provides libsystemd.so
# (flutter-pi links sd_event; runtime does not require PID 1 == systemd — see plan §3.6).

BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD=y

# P3.1 / dart-hal D11: systemd-networkd owns eth0/wlan0 L3;
# systemd-resolved is the standard DNS companion (no hand-written resolv.conf).
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y

# Desktop / extra systemd features not needed on HMI.
# BR2_PACKAGE_SYSTEMD_TIMESYNCD is not set
# BR2_PACKAGE_SYSTEMD_LOGIND is not set
# BR2_PACKAGE_SYSTEMD_POLKIT is not set
# BR2_PACKAGE_SYSTEMD_ANALYZE is not set
# BR2_PACKAGE_SYSTEMD_FIRSTBOOT is not set
# BR2_PACKAGE_SYSTEMD_HOMED is not set
# BR2_PACKAGE_SYSTEMD_HOSTNAMED is not set
# BR2_PACKAGE_SYSTEMD_MACHINED is not set
# BR2_PACKAGE_SYSTEMD_PORTABLED is not set
# BR2_PACKAGE_SYSTEMD_UTMP is not set

# Bake ssh host keys into staging target/ before image copy; fakeroot hook strips wants (see lws-hmi-post-*.sh).
# common/post-build.sh runs Rockchip post-hooks (incl. 30-fstab); post-build.sh runs after.
BR2_ROOTFS_POST_BUILD_SCRIPT="board/rockchip/common/post-build.sh board/rockchip/rk3566_rk3568/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="board/rockchip/rk3566_rk3568/post-fakeroot.sh"
