# flutter-pi + Flutter engine (SDK in-tree packages; meta-flutter app layout).
# Engine/icudtl: rootfs only (/usr/lib, /usr/share/flutter) via BR2_PACKAGE_FLUTTER_ENGINE.
# /opt/hmi: libapp.so + flutter_assets only (make build-app).
#
# Default rootfs (make build-rootfs) is flutter-pi only. Explicitly clear the
# Weston alternate stack so switching back from build-rootfs-weston does not
# leave those packages enabled in Buildroot output .config.

BR2_PACKAGE_FLUTTER_ENGINE=y
BR2_PACKAGE_FLUTTER_PI=y
BR2_PACKAGE_FLUTTER_PI_TEXT_INPUT_PLUGIN=y
# GStreamer/MPP: chips/lws_hmi_gst_rtsp.config (make build-gstreamer)

BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_LIBXKBCOMMON=y
# flutter-pi keyboard.c needs XKB data at /usr/share/X11/xkb (libxkbcommon alone is not enough).
BR2_PACKAGE_XKEYBOARD_CONFIG=y

# Mutually exclusive with chips/lws_hmi_wayland.config (weston image).
# BR2_PACKAGE_WAYLAND is not set
# BR2_PACKAGE_WAYLAND_PROTOCOLS is not set
# BR2_PACKAGE_WESTON is not set
# BR2_PACKAGE_FLUTTER_EMBEDDED_LINUX is not set
