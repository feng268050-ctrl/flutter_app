[Unit]
Description=flutter-pi HMI
DefaultDependencies=yes
After=local-fs.target lws-hmi-performance.service
# Optional on lws_hmi images: param-update.service / mainserver.service
# sdk-native: panel init is in kernel DTS (panel-init-sequence).
# Do not wait for network or MediaMTX (KPI = first home frame).

[Service]
Type=simple
Nice=-5
ExecStart=/usr/lib/lws-hmi/hmi-launch.sh
Restart=on-failure
RestartSec=2
Environment=FLUTTER_PI=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
