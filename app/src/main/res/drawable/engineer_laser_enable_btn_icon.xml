<?xml version="1.0" encoding="utf-8"?>
<!-- 工程师左侧 Laser Enable 图标：高度对齐 text_size_16（37sp） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="@dimen/engineer_laser_btn_icon_size"
        android:height="@dimen/engineer_laser_btn_icon_size"
        android:gravity="center">
        <selector>
            <item android:state_enabled="true" android:drawable="@mipmap/laser_enable" />
            <item android:state_enabled="false">
                <bitmap
                    android:alpha="0.5"
                    android:src="@mipmap/laser_enable" />
            </item>
        </selector>
    </item>
</layer-list>
