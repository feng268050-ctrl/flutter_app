[Unit]
Description=OEM display-init (mount /oem then board helper)
DefaultDependencies=no
After=systemd-remount-fs.service
Before=mainserver.service hmi.service sysinit.target
# Mount PARTLABEL=oem then exec OEM helpers/display-init.sh. P3.2 QEMU: oem-compose mounts /dev/vdb.
ConditionKernelCommandLine=!lws.emulator=1

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/display/display-init.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
