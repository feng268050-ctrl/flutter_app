# Phase 4c: P2/P3/P5 platform libs from prebuilt/platform-packages/target overlay.
# Populate: make build-platform-packages  (before make build-rootfs)
#
# Prebuilt path does not enable BR2_PACKAGE_AVAHI, so package AVAHI_USERS never
# runs — create the avahi system account via users table (mkusers).
# Path is relative to Buildroot topdir (buildroot/board/...); apply-overlay
# installs overlay/board/rockchip/common/avahi.users → common/lws-hmi/.
#
# OTA verify (ab-ota-verify.sh) needs the openssl *CLI* (dgst/pkeyutl). Platform
# prebuilt ships modbus/yaml/sqlite/avahi libs only — not openssl apps — so keep
# Buildroot libopenssl + BIN here even when other platform pkgs are prebuilt.
#
# Product GPIO halt / debug: gpioset/gpioinfo/gpioget (libgpiod tools). Prebuilt
# platform-packages do not ship these CLIs — keep Buildroot libgpiod + TOOLS.

BR2_PACKAGE_LIBOPENSSL=y
BR2_PACKAGE_LIBOPENSSL_BIN=y

BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y

# Entropy daemon (same as lws_hmi_platform.config; not in platform-packages prebuilt).
BR2_PACKAGE_RNG_TOOLS=y
BR2_PACKAGE_RNG_TOOLS_JITTERENTROPY_LIBRARY=y

BR2_ROOTFS_OVERLAY+="board/rockchip/common/lws-hmi-prebuilt-platform/"
BR2_ROOTFS_USERS_TABLES="board/rockchip/common/lws-hmi/avahi.users"
