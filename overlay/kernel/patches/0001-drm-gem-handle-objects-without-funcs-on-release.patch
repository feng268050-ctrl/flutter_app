From: lws-hmi kernel overlay
Subject: 0001-drm-gem-handle-objects-without-funcs-on-release.patch

diff -ruN a/drivers/gpu/drm/drm_gem.c b/drivers/gpu/drm/drm_gem.c
--- a/drivers/gpu/drm/drm_gem.c
+++ b/drivers/gpu/drm/drm_gem.c
@@ -226,6 +226,36 @@
 		drm_gem_object_put(obj);
 }
 
+static bool drm_gem_object_has_valid_device(struct drm_gem_object *obj)
+{
+	struct drm_device *dev;
+
+	if (!obj || (unsigned long)obj < PAGE_OFFSET || !virt_addr_valid(obj))
+		return false;
+
+	dev = READ_ONCE(obj->dev);
+	if (!dev || (unsigned long)dev < PAGE_OFFSET || !virt_addr_valid(dev))
+		return false;
+
+	return true;
+}
+
+static const struct drm_gem_object_funcs *
+drm_gem_object_get_funcs(struct drm_gem_object *obj)
+{
+	const struct drm_gem_object_funcs *expected;
+
+	expected = obj->dev->driver->gem_object_funcs;
+	if (expected && unlikely(READ_ONCE(obj->funcs) != expected)) {
+		pr_warn_ratelimited("drm: repairing corrupted GEM funcs for %s object %pK (%pK -> %pK)\n",
+				    obj->dev->driver->name, obj,
+				    READ_ONCE(obj->funcs), expected);
+		WRITE_ONCE(obj->funcs, expected);
+	}
+
+	return READ_ONCE(obj->funcs);
+}
+
 /*
  * Called at device or object close to release the file's
  * handle references on objects.
@@ -233,15 +263,23 @@
 static int
 drm_gem_object_release_handle(int id, void *ptr, void *data)
 {
+	const struct drm_gem_object_funcs *funcs;
 	struct drm_file *file_priv = data;
 	struct drm_gem_object *obj = ptr;
 
 	if (drm_WARN_ON(obj->dev, !data))
 		return 0;
 
-	if (obj->funcs->close)
-		obj->funcs->close(obj, file_priv);
+	if (!drm_gem_object_has_valid_device(obj)) {
+		pr_warn_ratelimited("drm: ignoring invalid GEM handle object/device %px\n",
+				    obj);
+		return 0;
+	}
 
+	funcs = drm_gem_object_get_funcs(obj);
+	if (funcs && funcs->close)
+		funcs->close(obj, file_priv);
+
 	drm_prime_remove_buf_handle(&file_priv->prime, id);
 	drm_vma_node_revoke(&obj->vma_node, file_priv);
 
@@ -960,13 +998,18 @@
 void
 drm_gem_object_free(struct kref *kref)
 {
+	const struct drm_gem_object_funcs *funcs;
 	struct drm_gem_object *obj =
 		container_of(kref, struct drm_gem_object, refcount);
 
-	if (WARN_ON(!obj->funcs->free))
+	if (WARN_ON(!drm_gem_object_has_valid_device(obj)))
 		return;
 
-	obj->funcs->free(obj);
+	funcs = drm_gem_object_get_funcs(obj);
+	if (WARN_ON(!funcs || !funcs->free))
+		return;
+
+	funcs->free(obj);
 }
 EXPORT_SYMBOL(drm_gem_object_free);
 
