# Default ynh960 USB: Micro-USB OTG plug-ssh (g_ether) + expansion USB host (1 mm).
# Module g_ether is loaded only while OTG VBUS is present.
#
# Use DWC3 dual-role (not gadget-only) so usbdrd can stay peripheral while
# usbhost_dwc3 (u2phy0_host / 1 mm expansion) can act as host for HID keyboards.
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_VBUS_DRAW=500
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_ETH=m
# CONFIG_USB_ETH_RNDIS is not set
CONFIG_USB_F_ECM=y
CONFIG_USB_DWC3=y
# CONFIG_USB_DWC3_HOST is not set
# CONFIG_USB_DWC3_GADGET is not set
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_DWC3_ROCKCHIP=y
CONFIG_USB_ROLE_SWITCH=y
# Wired HID keyboard on USB host expansion
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
